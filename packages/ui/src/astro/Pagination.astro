---
import "../components/pagination.css";
import { pageWindow } from "../lib/pagination";

interface Props {
  page: number;
  pages: number;
  /** Path the page links point at, without a query string. */
  path: string;
  /** Other query parameters to keep on every link (e.g. a sort). */
  query?: Record<string, string>;
  label?: string;
  /** Center the row (public pages); the admin footer leaves it right-aligned. */
  centered?: boolean;
}
const { page, pages, path, query = {}, label = "Pages", centered = false } = Astro.props;
const href = (n: number) => {
  const q = new URLSearchParams(query);
  if (n > 1) q.set("page", String(n));
  const s = q.toString();
  return s ? `${path}?${s}` : path;
};
const item = "kc-pagination__item";
---
{pages > 1 && (
  <nav class:list={["kc-pagination", { "kc-pagination--center": centered }]} aria-label={label}>
    {page > 1
      ? <a class={item} rel="prev" href={href(page - 1)} aria-label="Previous page"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" /></svg></a>
      : <span class={`${item} kc-pagination__item--disabled`} aria-hidden="true"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" /></svg></span>}
    {pageWindow(page, pages).map((n) =>
      n === null ? <span class="kc-pagination__gap" aria-hidden="true">…</span>
      : <a class={item} href={href(n)} aria-label={`Page ${n}`} aria-current={n === page ? "page" : undefined}>{n}</a>,
    )}
    {page < pages
      ? <a class={item} rel="next" href={href(page + 1)} aria-label="Next page"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" /></svg></a>
      : <span class={`${item} kc-pagination__item--disabled`} aria-hidden="true"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3l5 5-5 5" /></svg></span>}
  </nav>
)}
