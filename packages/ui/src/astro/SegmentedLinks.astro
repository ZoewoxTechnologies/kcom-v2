---
/* Segmented control made of links, for choices kept in the URL (a filter or an order). Works without
   JS: each option is a plain link, and the current one is marked with aria-current.
   Import "@kcom/ui/segmented-control.css" once per page. */
interface Props {
  options: { value: string; label: string; href: string }[];
  /** The value of the current option. */
  current: string;
  /** What the control chooses, read out by screen readers (for example "Order"). */
  label: string;
  class?: string;
}
const { options, current, label, class: className } = Astro.props;
---

<nav class:list={["kc-segmented", className]} aria-label={label}>
  {options.map((o) => (
    <a
      class="kc-segmented__option"
      href={o.href}
      aria-current={o.value === current ? "true" : undefined}
    >
      {o.label}
    </a>
  ))}
</nav>
