# Base URL of the API the admin calls.
VITE_API_URL=http://localhost:3000
# Public site origin, linked from the admin side menu brand.
VITE_SITE_URL=http://localhost:4321
# Dev server port (default 5173). `pnpm dev:ports` sets it per worktree so several checkouts can run at once.
DEV_PORT=5173

# Sentry (optional; build-time. No-op when VITE_SENTRY_DSN is empty)
VITE_SENTRY_DSN=
# Environment name reported to Sentry, e.g. production.
VITE_SENTRY_ENVIRONMENT=
# Release identifier reported to Sentry.
VITE_SENTRY_RELEASE=
