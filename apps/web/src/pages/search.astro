---
import BaseLayout from "../layouts/BaseLayout.astro";

Astro.response.headers.set("cache-control", "public, max-age=0, s-maxage=300");
---
<BaseLayout bleed title="Search" description="Search capsules, blog posts, series, events, books and About pages." current="/search" noindex>
  <div class="search" data-search>
    <section class="band">
      <form role="search" action="/search" method="get" class="form inner">
        <label for="sq" class="kc-label">Search the site</label>
        <div class="row">
          <input id="sq" name="q" type="search" class="kc-input kc-input--lg" autocomplete="off" autofocus />
        </div>
        <p class="status" role="status" aria-live="polite" data-status>
          <noscript>Search needs JavaScript. Please enable it to search the site.</noscript>
        </p>
      </form>
    </section>

    <div class="body inner" hidden data-body>
      <aside aria-label="Filters" class="filters" data-filters>
        <fieldset class="kc-fieldset types" data-types>
          <legend>Type</legend>
        </fieldset>
        <div class="kc-field">
          <label class="kc-label" for="sy">Year</label>
          <div class="kc-select"><select id="sy" class="kc-select__control kc-select__control--sm" data-year><option value="">Any year</option></select></div>
        </div>
        <div class="kc-field">
          <label class="kc-label" for="ss">Series</label>
          <div class="kc-select"><select id="ss" class="kc-select__control kc-select__control--sm" data-series><option value="">Any series</option></select></div>
        </div>
        <a href="/search" class="clear" data-clear>Clear filters</a>
      </aside>

      <section aria-label="Results" class="results">
        <div data-results></div>
        <nav class="kc-pagination kc-pagination--center pager" aria-label="Search result pages" data-pager hidden></nav>
        <div class="empty" data-empty hidden>
          <span class="empty-title" data-empty-title></span>
          <span class="empty-help">Try fewer or different words, a Bible reference such as “Romans 12”, or <a href="/series">browse by series</a>.</span>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
<script>
  import { pageWindow } from "@kcom/ui/pagination";

  interface Segment { text: string; match: boolean }
  interface Hit { type: string; url: string; title: string; date: string | null; series: string | null; excerpt: Segment[] }

  const root = document.querySelector<HTMLElement>("[data-search]")!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const input = $<HTMLInputElement>("#sq");
  const status = $("[data-status]");
  const body = $("[data-body]");
  const typesBox = $("[data-types]");
  const year = $<HTMLSelectElement>("[data-year]");
  const series = $<HTMLSelectElement>("[data-series]");
  const clear = $("[data-clear]");
  const results = $("[data-results]");
  const pager = $("[data-pager]");
  const empty = $("[data-empty]");
  const emptyTitle = $("[data-empty-title]");

  const API = (import.meta.env.PUBLIC_API_URL ?? "").replace(/\/+$/, "");
  const PAGE = 10;
  const TYPING_MS = 300;
  const TYPE_LABELS: Record<string, string> = { Capsule: "Capsules", Blog: "Blog", Series: "Series", Event: "Events", Book: "Books", Page: "Pages" };
  const TYPE_ORDER = Object.keys(TYPE_LABELS);
  const params = new URL(location.href).searchParams;
  const selected = new Set(params.getAll("type"));
  year.dataset.want = params.get("year") ?? "";
  series.dataset.want = params.get("series") ?? "";
  input.value = params.get("q") ?? "";

  let fetched: { q: string; hits: Hit[] } | null = null;
  let shown: Hit[] = [];
  let page = Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1);
  let timer: ReturnType<typeof setTimeout> | undefined;
  let token = 0;
  let controller: AbortController | undefined;

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  const dateLabel = (d: string | null) => (d && /^\d{4}-\d{2}-\d{2}$/.test(d) ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(d)) : (d ?? ""));
  const yearOf = (h: Hit) => (h.date && /^\d{4}/.test(h.date) ? h.date.slice(0, 4) : null);

  function syncUrl() {
    const u = new URL(location.href);
    u.search = "";
    if (input.value.trim()) u.searchParams.set("q", input.value.trim());
    for (const t of selected) u.searchParams.append("type", t);
    if (year.value) u.searchParams.set("year", year.value);
    if (series.value) u.searchParams.set("series", series.value);
    if (page > 1) u.searchParams.set("page", String(page));
    history.replaceState(null, "", u);
  }

  function fillSelect(sel: HTMLSelectElement, any: string, values: Set<string>, newestFirst: boolean) {
    const want = sel.value || sel.dataset.want || "";
    sel.dataset.want = "";
    const keys = [...values].sort((a, b) => (newestFirst ? b.localeCompare(a) : a.localeCompare(b)));
    if (want && !keys.includes(want)) keys.push(want);
    sel.replaceChildren(new Option(any, ""), ...keys.map((k) => new Option(k, k)));
    sel.value = want;
  }

  function fillTypes(counts: Record<string, number>) {
    typesBox.querySelectorAll("label").forEach((l) => l.remove());
    for (const type of TYPE_ORDER) {
      const label = el("label", "kc-choice");
      const box = el("input") as HTMLInputElement;
      box.type = "checkbox";
      box.checked = selected.size === 0 || selected.has(type);
      box.addEventListener("change", () => {
        const boxes = [...typesBox.querySelectorAll<HTMLInputElement>("input")];
        const on = boxes.filter((b) => b.checked);
        selected.clear();
        if (on.length && on.length < boxes.length) on.forEach((b) => selected.add(b.closest("label")!.querySelector<HTMLElement>(".count")!.dataset.type!));
        apply(false);
      });
      const count = el("span", "count", String(counts[type] ?? 0));
      count.dataset.type = type;
      label.append(box, TYPE_LABELS[type] ?? type, count);
      typesBox.append(label);
    }
  }

  const CHEVRON = { prev: "M10 3 5 8l5 5", next: "M6 3l5 5-5 5" };
  function pagerLink(n: number, label: string, content: string | SVGElement, current = false) {
    const a = el("a", "kc-pagination__item") as HTMLAnchorElement;
    a.href = "#";
    a.setAttribute("aria-label", label);
    if (current) a.setAttribute("aria-current", "page");
    typeof content === "string" ? (a.textContent = content) : a.append(content);
    a.addEventListener("click", (e) => {
      e.preventDefault();
      if (!current) go(n);
    });
    return a;
  }
  function chevron(kind: "prev" | "next") {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 16 16");
    svg.setAttribute("aria-hidden", "true");
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("d", CHEVRON[kind]);
    svg.append(path);
    return svg;
  }
  function renderPager(pages: number) {
    pager.replaceChildren();
    pager.hidden = pages <= 1;
    if (pages <= 1) return;
    const edge = (kind: "prev" | "next", n: number, on: boolean) => {
      if (on) return pagerLink(n, kind === "prev" ? "Previous page" : "Next page", chevron(kind));
      const off = el("span", "kc-pagination__item kc-pagination__item--disabled");
      off.setAttribute("aria-hidden", "true");
      off.append(chevron(kind));
      return off;
    };
    pager.append(edge("prev", page - 1, page > 1));
    for (const n of pageWindow(page, pages)) {
      if (n === null) {
        const gap = el("span", "kc-pagination__gap", "…");
        gap.setAttribute("aria-hidden", "true");
        pager.append(gap);
      } else pager.append(pagerLink(n, `Page ${n}`, String(n), n === page));
    }
    pager.append(edge("next", page + 1, page < pages));
  }

  function renderPage() {
    const pages = Math.max(1, Math.ceil(shown.length / PAGE));
    page = Math.min(Math.max(page, 1), pages);
    results.replaceChildren();
    for (const h of shown.slice((page - 1) * PAGE, page * PAGE)) {
      const a = el("a", "hit") as HTMLAnchorElement;
      a.href = h.url;
      const meta = el("span", "hit-meta");
      meta.append(el("span", "chip", h.type), el("span", "date", dateLabel(h.date)));
      const title = el("span", "hit-title", h.title);
      const ex = el("span", "excerpt");
      // Excerpts arrive as plain-text segments; matches become <mark>, never markup.
      for (const seg of h.excerpt) ex.append(seg.match ? el("mark", undefined, seg.text) : document.createTextNode(seg.text));
      a.append(meta, title, ex);
      results.append(a);
    }
    renderPager(pages);
    syncUrl();
  }

  function go(n: number) {
    page = n;
    renderPage();
    results.scrollIntoView({ block: "start", behavior: "smooth" });
  }

  /** Filters the fetched hits by type, year and series and draws them. `refill` rebuilds the filter lists. */
  function apply(refill: boolean, keepPage = false) {
    if (!fetched) return;
    if (!keepPage) page = 1;
    const { q, hits } = fetched;
    const inYearAndSeries = hits.filter((h) => (!year.value || yearOf(h) === year.value) && (!series.value || h.series === series.value));
    const counts: Record<string, number> = {};
    for (const h of inYearAndSeries) counts[h.type] = (counts[h.type] ?? 0) + 1;
    if (refill) {
      fillTypes(counts);
      fillSelect(year, "Any year", new Set(hits.map(yearOf).filter((y): y is string => !!y)), true);
      fillSelect(series, "Any series", new Set(hits.map((h) => h.series).filter((s): s is string => !!s)), false);
    } else {
      typesBox.querySelectorAll<HTMLElement>(".count").forEach((c) => {
        c.textContent = String(counts[c.dataset.type ?? ""] ?? 0);
      });
    }
    shown = inYearAndSeries.filter((h) => selected.size === 0 || selected.has(h.type));
    body.hidden = false;
    const n = shown.length;
    empty.hidden = n > 0;
    if (n === 0) {
      results.replaceChildren();
      pager.hidden = true;
    }
    emptyTitle.textContent = `No results for “${q}”`;
    status.textContent = n ? `${n} ${n === 1 ? "result" : "results"} for “${q}”` : "";
    renderPage();
  }

  async function run(keepPage = false) {
    clearTimeout(timer);
    controller?.abort();
    const q = input.value.trim();
    const mine = ++token;
    if (!keepPage) page = 1;
    if (!q) {
      fetched = null;
      body.hidden = true;
      status.textContent = "";
      syncUrl();
      return;
    }
    controller = new AbortController();
    try {
      const res = await fetch(`${API}/search?q=${encodeURIComponent(q)}`, { signal: controller.signal });
      if (mine !== token) return;
      if (res.status === 429) {
        status.textContent = "Too many searches. Please wait a moment and try again.";
        return;
      }
      if (!res.ok) throw new Error(String(res.status));
      fetched = { q, hits: ((await res.json()) as { hits: Hit[] }).hits };
    } catch (err) {
      if (mine !== token || (err as Error).name === "AbortError") return;
      status.textContent = "Search is not available right now.";
      return;
    }
    apply(true, keepPage);
  }

  year.addEventListener("change", () => apply(false));
  series.addEventListener("change", () => apply(false));
  input.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(() => void run(), TYPING_MS);
  });
  input.form!.addEventListener("submit", (e) => {
    e.preventDefault();
    void run();
  });
  clear.addEventListener("click", (e) => {
    e.preventDefault();
    selected.clear();
    year.value = series.value = "";
    apply(false);
  });

  void run(true);
</script>
<style is:global>
  .search { display: flex; flex-direction: column; }
  .search .inner { box-sizing: border-box; inline-size: 100%; max-inline-size: var(--page-max); margin-inline: auto; padding-inline: var(--gutter); }
  .search .band { background: var(--color-wash); padding-block: 40px 32px; }
  .search .band, .search .form { min-inline-size: 0; }
  .search .form { display: flex; flex-direction: column; gap: 10px; }
  .search .row { display: flex; gap: 10px; max-inline-size: 760px; }
  .search .row .kc-input { flex: 1; min-inline-size: 0; block-size: 57px; padding: 14px 18px; border-radius: 12px; font-size: 1.25rem; }
  .search .kc-select__control { --kc-control-height: 46px; }
  .search .status { margin: 0; min-block-size: 1.5em; font-size: 0.9375rem; color: var(--color-muted); }
  .search .body { display: flex; flex-wrap: wrap; gap: 48px; padding-block: 32px 72px; }
  .search .body[hidden] { display: none; }
  .search .filters { flex: 1 1 220px; max-inline-size: 250px; display: flex; flex-direction: column; gap: var(--space-5); font-size: 0.9375rem; }
  .search .types { display: flex; flex-direction: column; gap: 0; }
  .search .types legend { font-weight: 700; margin-block-end: var(--space-2); padding: 0; }
  .search .types .kc-choice { min-block-size: 2rem; }
  .search .count { margin-inline-start: auto; color: var(--color-muted); }
  .search .clear { font-weight: 600; }
  .search .results { flex: 999 1 560px; min-inline-size: 0; display: flex; flex-direction: column; }
  .search .hit { display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--color-line); color: var(--color-text); text-decoration: none; }
  .search .hit:hover .hit-title { color: var(--color-primary); }
  .search .hit-meta { display: flex; gap: 10px; align-items: center; font-size: 0.8125rem; font-weight: 700; }
  .search .chip { color: var(--color-primary); background: var(--color-hover); border-radius: var(--radius-pill); padding: 2px 10px; }
  .search .date { letter-spacing: 0.08em; font-variant: small-caps; color: var(--color-gold-text); }
  .search .hit-title { font: 600 1.625rem / 1.2 var(--font-title); overflow-wrap: anywhere; }
  .search .excerpt { font-size: 1rem; color: color-mix(in srgb, var(--color-text) 53%, var(--color-muted)); }
  .search .excerpt mark { background: var(--color-sandstone); color: var(--color-text); border-bottom: 2px solid var(--color-gold); padding: 0 2px; }
  .search .pager { margin-block-start: var(--space-5); }
  .search .empty { margin-block-start: var(--space-7); border: 1px dashed var(--color-field); border-radius: var(--radius); padding: 28px; display: flex; flex-direction: column; gap: var(--space-2); background: var(--color-surface); }
  .search .empty[hidden], .search .pager[hidden] { display: none; }
  .search .empty-title { font: 600 1.625rem / 1.2 var(--font-title); }
  .search .empty-help { color: var(--color-muted); }
  @media (max-width: 47.99rem) {
    .search .band { padding-block: var(--space-5) var(--space-4); }
    .search .body { gap: var(--space-5); }
    .search .filters { max-inline-size: none; flex-basis: 100%; }
  }
</style>
