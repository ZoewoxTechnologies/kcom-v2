---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { dayParts, lagosDate } from "@kcom/content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSection from "../components/HomeSection.astro";
import SeriesCard from "../components/SeriesCard.astro";
import SignupForm from "../components/SignupForm.astro";
import { data } from "../lib/data";
import { richTextToPlain } from "../lib/data/client";
import { capsulePath, seriesPath, sortSeries } from "../lib/archive";
import { postKicker } from "../lib/blog";
import {
  defaultSections,
  featuredQuote,
  recentSeriesRows,
  sampleBooks,
  sampleEvents,
  sectionsFromApi,
  sectionsFromQuery,
  visibleSections,
} from "../lib/homepage";

const today = lagosDate(new Date());
let capsule = await data.capsuleByDate(today);
if (!capsule) {
  const latest = await data.latestCapsule();
  capsule = latest ? await data.capsuleBySlug(latest.slug) : null;
}
const neighbours = capsule ? await data.capsuleNeighbours(capsule.slug) : null;

// The section list comes from the homepage API; `?sections=` previews an arrangement outside production.
const preview = import.meta.env.PROD
  ? null
  : sectionsFromQuery(Astro.url.searchParams.get("sections"));
const apiSections = preview ? null : sectionsFromApi(await data.listHomepageSections());
const order = visibleSections(preview ?? apiSections ?? defaultSections);

const allSeries = sortSeries(await data.listSeries(), "newest");
const current = allSeries.find((s) => s.inProgress) ?? allSeries[0] ?? null;
const currentDetail = current ? await data.seriesBySlug(current.slug) : null;
const pastSeries = allSeries.filter((s) => s.slug !== current?.slug).slice(0, 4);
const [post] = await data.listBlogPosts({ limit: 1 });
const shortDate = (day: string) =>
  new Date(`${day}T12:00:00Z`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    timeZone: "UTC",
  });
const monthDay = (day: string) => ({
  mon: new Date(`${day}T12:00:00Z`)
    .toLocaleDateString("en-GB", { month: "short", timeZone: "UTC" })
    .toUpperCase(),
  n: day.slice(8),
});
const seriesRows = recentSeriesRows(currentDetail?.capsules ?? [], today);
const rowTag = (c: { displayDate: string; partNumber: number | null }) =>
  c.displayDate === today ? "Today" : c.partNumber ? `Day ${c.partNumber}` : "";

const heroDay = capsule ? dayParts(capsule.displayDate) : null;
const verse = capsule ? richTextToPlain(capsule.scriptureText) || capsule.bibleMeditation : null;
const events = sampleEvents;
const books = sampleBooks;
Astro.response.headers.set("cache-control", "public, max-age=0, s-maxage=300");
---

<BaseLayout title="Home" current="/" bleed hideSignup={order.includes("signup")}>
  {order.map((key) => {
    if (key === "today")
      return (
        <section class="band wash" aria-label="Today’s Capsule">
          <div class="inner hero">
            {capsule ? (
              <>
                <div class="photo" aria-hidden="true">
                  {capsule.bannerUrl && (
                    <ResponsiveImage
                      src={capsule.bannerUrl}
                      widths={[480, 640, 800, 1200]}
                      ratio={4 / 3}
                      sizes="(min-width: 60rem) 36rem, 100vw"
                      eager
                    />
                  )}
                </div>
                <div class="copy">
                  <span class="eyebrow">Today’s Capsule · {heroDay!.rest}</span>
                  <h1>{capsule.title}</h1>
                  <span class="rule" aria-hidden="true"></span>
                  {verse && <p class="verse">{verse}</p>}
                  {capsule.scriptureRef && <span class="ref">{capsule.scriptureRef}</span>}
                  <div class="actions">
                    <a class="kc-btn kc-btn--primary kc-btn--sm" href="/capsules/today">
                      Read today’s capsule
                    </a>
                    {neighbours?.prev && (
                      <a class="more yday" href={capsulePath(neighbours.prev.slug)}>
                        Yesterday’s capsule →
                      </a>
                    )}
                  </div>
                </div>
              </>
            ) : (
              <div class="copy">
                <h1>Kingdom Capstone Outreach Ministries</h1>
                <p class="muted">Today’s capsule isn’t available yet. Please check back soon.</p>
              </div>
            )}
          </div>
        </section>
      );
    if (key === "current-series")
      return (
        <section class="band" aria-label="Current series">
          <div class="inner">
            <div class="split">
              <div class="intro">
                <span class="eyebrow">Current series</span>
                {current ? (
                  <>
                    <h2>{current.title}</h2>
                    {current.description && <p class="muted">{current.description}</p>}
                    <a class="more" href={seriesPath(current.slug)}>
                      See the whole series →
                    </a>
                  </>
                ) : (
                  <p class="muted">No series is running right now.</p>
                )}
              </div>
              {seriesRows.length > 0 && (
                <ol class="rows">
                  {seriesRows.map((c) => (
                    <li>
                      <span class="date">{shortDate(c.displayDate)}</span>
                      <a href={capsulePath(c.slug)}>
                        <span class="rt">{c.title}</span>
                        {c.scriptureRef && <span class="rm">{c.scriptureRef}</span>}
                      </a>
                      <span class="tag">{rowTag(c)}</span>
                    </li>
                  ))}
                </ol>
              )}
            </div>
          </div>
        </section>
      );
    if (key === "past-series")
      return (
        <section class="band" aria-label="Explore past series">
          <div class="inner">
            <HomeSection
              title="Explore past series"
              more={{ href: "/series", label: "All series →" }}
              isEmpty={pastSeries.length === 0}
              empty="Past series will appear here."
            >
              <div class="grid4">
                {pastSeries.map((s) => (
                  <SeriesCard series={s} />
                ))}
              </div>
            </HomeSection>
          </div>
        </section>
      );
    if (key === "blog")
      return (
        <section class="band" aria-label="From the blog">
          <div class="inner">
            {post ? (
              <div class="feature">
                <div class="fcopy">
                  <span class="eyebrow">
                    From the blog{post.tags[0] ? ` · ${post.tags[0]}` : ""}
                  </span>
                  <h2>{post.title}</h2>
                  {post.excerpt && <p>{post.excerpt}</p>}
                  <a class="more" href={`/blog/${post.slug}`}>
                    Read the message →
                  </a>
                </div>
                {featuredQuote && (
                  <blockquote>
                    “{featuredQuote.text}”<cite>{featuredQuote.ref}</cite>
                  </blockquote>
                )}
              </div>
            ) : (
              <HomeSection title="From the blog" isEmpty empty="No posts yet. Check back soon." />
            )}
          </div>
        </section>
      );
    if (key === "events-books")
      return (
        <section class="band" aria-label="Upcoming events and books">
          <div class="inner two">
            <HomeSection
              title="Upcoming events"
              more={{ href: "/events", label: "All events →" }}
              moreBelow
              isEmpty={events.length === 0}
              empty="No upcoming events right now."
            >
              <ul class="events">
                {events.map((e) => {
                  const d = monthDay(e.date);
                  return (
                    <li>
                      <a href="/events">
                        <span class="tile">
                          <span class="mon">{d.mon}</span>
                          <span class="dn">{d.n}</span>
                        </span>
                        <span class="et">{e.title}</span>
                        <span class="em">{e.meta}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </HomeSection>
            <HomeSection
              title="Books from the ministry"
              isEmpty={books.length === 0}
              empty="Books will be listed here."
            >
              <ul class="books">
                {books.map((b) => (
                  <li>
                    <a href="/books">
                      <span class="cover" aria-hidden="true"></span>
                      <span class="bt">{b.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </HomeSection>
          </div>
        </section>
      );
    return (
      <section class="band signup" aria-label="Email signup">
        <div class="inner narrow">
          <h2>Begin each day in the Word</h2>
          <p>
            The daily Capstone Capsule in your inbox every day at midnight. Free, and you can leave
            any time.
          </p>
          <SignupForm id="home-email" placeholder="you@example.com" />
        </div>
      </section>
    );
  })}
</BaseLayout>
<style>
  /* The design sets 17px / 1.65 on the page wrapper. */
  .band {
    padding: 0 2.5rem 4.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  .band:first-child,
  .signup {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .band[aria-label="Current series"] {
    padding-top: 4.5rem;
  }
  .wash {
    background: var(--color-wash);
  }
  .inner {
    max-inline-size: 75rem;
    margin-inline: auto;
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
  }
  .photo {
    flex: 1 1 26rem;
    min-inline-size: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: linear-gradient(160deg, #9fbcc6, var(--color-primary));
    overflow: hidden;
  }
  .photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }
  .copy {
    flex: 1 1 24rem;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .copy h1 {
    margin: 0;
    font: 500 clamp(2.25rem, 7vw, 4rem) / 1.02 var(--font-title);
  }
  .copy .eyebrow {
    font-size: 0.875rem;
  }
  .rule {
    inline-size: 3rem;
    block-size: 2px;
    background: var(--color-gold);
  }
  .eyebrow {
    font-size: 0.8125rem;
    line-height: 1.65;
    letter-spacing: 0.1em;
    font-variant: small-caps;
    font-weight: 700;
    color: var(--color-gold-text);
  }
  .verse {
    margin: 0;
    font: italic 400 1.3125rem / 1.6 var(--font-scripture);
  }
  .ref {
    font-size: 0.8125rem;
    line-height: 1.65;
    letter-spacing: 0.1em;
    font-variant: small-caps;
    font-weight: 700;
    color: var(--color-muted);
  }
  .actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
  .more {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .muted {
    margin: 0;
    color: var(--color-muted);
  }
  .split {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 4.5rem;
  }
  .intro {
    flex: 1 1 20rem;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .intro h2 {
    margin: 0;
    font: 600 2.5rem / 1.1 var(--font-title);
  }
  .rows {
    flex: 2 1 30rem;
    min-inline-size: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: flex;
    gap: var(--space-5);
    align-items: baseline;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-line);
  }
  .rows .date {
    inline-size: 5.625rem;
    flex: none;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    font-variant: small-caps;
    font-weight: 700;
    color: var(--color-muted);
  }
  .rows a {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    text-decoration: none;
    min-inline-size: 0;
  }
  .rows a:hover .rt {
    color: var(--color-primary);
  }
  .rt {
    font: 600 1.625rem / 1.2 var(--font-title);
  }
  .rm {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .tag {
    margin-inline-start: auto;
    flex: none;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-gold-text);
  }
  .grid4 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17.5rem, 100%), 1fr));
    gap: var(--space-4);
  }
  .feature {
    background: var(--color-sandstone);
    color: var(--color-text);
    border-radius: var(--radius);
    padding: 3.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    align-items: center;
  }
  .fcopy {
    flex: 2 1 32.5rem;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .fcopy h2 {
    margin: 0;
    font: 500 clamp(1.875rem, 5vw, 2.875rem) / 1.08 var(--font-title);
  }
  .fcopy p {
    margin: 0;
    max-inline-size: 40rem;
  }
  blockquote {
    flex: 1 1 18.75rem;
    margin: 0;
    font: italic 400 1.875rem / 1.3 var(--font-title);
    border-top: 2px solid var(--color-gold);
    padding-top: var(--space-4);
  }
  cite {
    display: block;
    margin-top: var(--space-2);
    font: normal 700 0.8125rem / 1.3 var(--font-body);
    letter-spacing: 0.1em;
    font-variant: small-caps;
    color: var(--color-gold-text-tint);
  }
  .fcopy .eyebrow {
    color: var(--color-gold-text-tint);
  }
  .events {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .events a {
    display: flex;
    align-items: center;
    column-gap: var(--space-4);
    row-gap: 0;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    flex-wrap: wrap;
  }
  .tile {
    inline-size: 3.5rem;
    block-size: 3.5rem;
    flex: none;
    border-radius: 12px;
    background: var(--color-wash);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
  }
  .mon {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }
  .dn {
    font: 600 1.75rem / 1.1 var(--font-title);
  }
  .et {
    font-weight: 700;
    flex: 1 1 12rem;
  }
  .em {
    flex-basis: 100%;
    padding-inline-start: 4.5rem;
    margin-top: -0.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .two {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-7);
  }
  .two > :global(*) {
    flex: 1 1 24rem;
  }
  .two {
    --sec-title: 2.25rem;
  }
  .books {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }
  .books a {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }
  .cover {
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    background: var(--color-wash);
    border: 1px solid var(--color-line);
  }
  .bt {
    font: 600 1.25rem / 1.2 var(--font-title);
  }
  .signup {
    background: var(--color-footer);
    color: var(--color-on-footer);
  }
  .narrow {
    max-inline-size: 47rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
  }
  .narrow h2 {
    margin: 0;
    font: 500 clamp(1.75rem, 5vw, 2.75rem) / 1.65 var(--font-title);
  }
  .narrow p {
    margin: 0;
    opacity: 0.9;
    max-inline-size: 40rem;
  }
  .narrow :global(.signup-form) {
    inline-size: 100%;
    max-inline-size: 32rem;
  }
  .narrow :global(.kc-input) {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .narrow :global(.kc-input::placeholder) {
    color: rgba(255, 255, 255, 0.8);
  }
  .narrow :global(.kc-btn) {
    --kc-btn-bg: var(--color-footer-button);
    --kc-btn-fg: var(--color-on-footer-button);
    --kc-btn-border: var(--color-footer-button);
  }
  @media (max-width: 47.999rem) {
    .band {
      padding-inline: var(--gutter);
      padding-bottom: 3rem;
    }
    .intro h2 {
      font-size: 2rem;
    }
    .feature {
      padding: var(--space-5);
    }
    blockquote {
      font-size: 1.5rem;
    }
    .yday,
    blockquote {
      display: none;
    }
    .grid4 > :nth-child(n + 3) {
      display: none;
    }
    .narrow {
      align-items: flex-start;
      text-align: start;
    }
  }
</style>
