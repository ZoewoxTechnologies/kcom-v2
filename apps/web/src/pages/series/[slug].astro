---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveHeader from "../../components/ArchiveHeader.astro";
import CapsuleRow from "../../components/CapsuleRow.astro";
import Pagination from "@kcom/ui/astro/Pagination.astro";
import SegmentedLinks from "@kcom/ui/astro/SegmentedLinks.astro";
import "@kcom/ui/segmented-control.css";
import { paginate } from "@kcom/ui/pagination";
import { data } from "../../lib/data";
import { inOrder, parseOrder } from "../../lib/data/series";
import { SERIES_CAPSULES_PAGE_SIZE, capsulePath, plural } from "../../lib/archive";
import { formatLagosDate, shortMonthYear } from "@kcom/content";

const slug = Astro.params.slug ?? "";
const detail = /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(slug) ? await data.seriesBySlug(slug) : null;
if (!detail) return Astro.rewrite("/404");
const { series: s, capsules } = detail;
const order = parseOrder(Astro.url.searchParams.get("order"));
const { page, pages, items } = paginate(
  inOrder(capsules, order),
  Astro.url.searchParams.get("page"),
  SERIES_CAPSULES_PAGE_SIZE,
);
const offset = (page - 1) * SERIES_CAPSULES_PAGE_SIZE;
// Number a row by its part, else by its place in Day 1 first order.
const dayOf = (c: { partNumber: number | null }, i: number) =>
  c.partNumber ?? (order === "newest" ? capsules.length - offset - i : offset + i + 1);
const orders = [
  { value: "oldest", label: "Oldest first", href: `/series/${s.slug}` },
  { value: "newest", label: "Newest first", href: `/series/${s.slug}?order=newest` },
];
---

<BaseLayout
  title={s.title}
  description={s.description ?? `The ${s.title} series of Capstone Capsules.`}
  current="/series"
>
  <ArchiveHeader tab="series" />
  <div class="body">
    <a class="back" href="/series">
      ← All series
    </a>
    <div class="heading">
      <h2>{s.title}</h2>
      <span class="facts">
        {shortMonthYear(s.firstDate)} · {plural(s.count, "day")}
        {s.inProgress ? ` · In progress, Day ${s.latestPart}` : ""}
      </span>
    </div>
    {s.description && <p class="desc">{s.description}</p>}
    {capsules.length > 1 && (
      <div class="order">
        <SegmentedLinks label="Order" current={order} options={orders} />
      </div>
    )}
    <div class="list">
      {items.map((c, i) => (
        <CapsuleRow
          href={capsulePath(c.slug)}
          kicker="DAY"
          figure={dayOf(c, i)}
          title={c.title}
          meta={`${formatLagosDate(c.displayDate)}${c.scriptureRef ? ` · ${c.scriptureRef}` : ""}`}
        />
      ))}
    </div>
    <Pagination
      centered
      page={page}
      pages={pages}
      path={`/series/${s.slug}`}
      query={order === "newest" ? { order } : {}}
    />
  </div>
</BaseLayout>
<style>
  .body {
    inline-size: 100%;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-5) var(--space-7);
  }
  .back {
    font-weight: 600;
    width: max-content;
  }
  .heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    flex-wrap: wrap;
  }
  h2 {
    margin: 0;
    font-size: 2rem;
  }
  .facts {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .desc {
    margin: 0;
    color: var(--color-muted);
    max-inline-size: 40rem;
  }
  /* The padding keeps the options' 44px touch areas inside the scroll box, which would otherwise clip them. */
  .order {
    align-self: flex-start;
    max-inline-size: 100%;
    overflow-x: auto;
    padding-block: 0.375rem;
    margin-block: -0.375rem;
  }
  .list {
    display: flex;
    flex-direction: column;
    margin-block: var(--space-3) var(--space-4);
  }
  @media (min-width: 48rem) {
    h2 {
      font-size: 2.5rem;
    }
  }
</style>
