---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveHeader from "../../components/ArchiveHeader.astro";
import Pagination from "@kcom/ui/astro/Pagination.astro";
import { paginate } from "@kcom/ui/pagination";
import SelectForm from "../../components/SelectForm.astro";
import SeriesCard from "../../components/SeriesCard.astro";
import { data } from "../../lib/data";
import { SERIES_PAGE_SIZE, parseSort, plural, seriesSorts, sortSeries } from "../../lib/archive";

const sort = parseSort(Astro.url.searchParams.get("sort"));
const all = sortSeries(await data.listSeries(), sort);
const { page, pages, items } = paginate(all, Astro.url.searchParams.get("page"), SERIES_PAGE_SIZE);
---
<BaseLayout title="Capsule series" description="Browse Capstone Capsules by series." current="/series">
  <ArchiveHeader tab="series" intro="Every daily capsule since 2012, to read and share." />
  <div class="body">
    <div class="bar">
      <span class="count">{plural(all.length, "series", "series")}</span>
      <SelectForm class="sort" name="sort" label="Sort" inline options={seriesSorts} value={sort} />
    </div>
    {all.length === 0 && <p class="empty">No series yet.</p>}
    <div class="grid">{items.map((s) => <SeriesCard series={s} />)}</div>
    <Pagination centered page={page} pages={pages} path="/series" query={sort === "newest" ? {} : { sort }} />
  </div>
</BaseLayout>
<style>
  .body { inline-size: 100%; margin-inline: auto; display: flex; flex-direction: column; gap: var(--space-5); padding-block: var(--space-4) var(--space-8); }
  .bar { display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap; }
  .count { color: var(--color-muted); font-size: 0.9375rem; }
  .bar :global(.sort) { margin-inline-start: auto; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-3); }
  .empty { color: var(--color-muted); }
  @media (min-width: 48rem) {
    .body { padding-block-start: 2.5rem; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-5); }
  }
</style>
