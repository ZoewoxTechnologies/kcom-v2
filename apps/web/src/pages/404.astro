---
import BaseLayout from "../layouts/BaseLayout.astro";
Astro.response.status = 404;
---
<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="nf">
    <p class="kicker">Error 404</p>
    <h1>This page could not be found</h1>
    <p>The link may be old, or the page may have moved. Today’s capsule and the archive are a good place to start.</p>
    <p class="actions">
      <a class="kc-btn kc-btn--primary" href="/capsules/today">Today’s Capsule</a>
      <a class="kc-btn kc-btn--secondary" href="/capsules">Browse the archive</a>
    </p>
  </section>
</BaseLayout>
<style>
  .nf { max-inline-size: 40rem; margin-inline: auto; padding: var(--space-7) var(--gutter); text-align: center; }
  .kicker { margin: 0; font-variant: small-caps; letter-spacing: 0.1em; font-weight: 700; color: var(--color-muted); }
  h1 { margin: var(--space-2) 0 var(--space-4); font-size: 2.25rem; }
  p { color: var(--color-muted); }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-block-start: var(--space-5); }
</style>
