---
import BaseLayout from "../layouts/BaseLayout.astro";
Astro.response.status = 404;
const links = [
  { href: "/capsules/today", label: "Today’s Capsule" },
  { href: "/series", label: "Browse by series" },
  { href: "/blog", label: "Blog" },
  { href: "/", label: "Home" },
];
---
<BaseLayout title="Page not found" description="This page could not be found." noindex>
  <section class="nf">
    <span class="code" aria-hidden="true">404</span>
    <h1>This page has wandered off</h1>
    <blockquote>
      “He leadeth me beside the still waters. He restoreth my soul.”
      <cite>Psalm 23:2–3</cite>
    </blockquote>
    <p class="note">The link may be old, or the page may have moved. Try a search, or start from one of these.</p>
    <form role="search" action="/search" method="get" class="find" data-find>
      <label for="nf-q" class="sr-only">Search the site</label>
      <input id="nf-q" name="q" type="search" class="kc-input kc-input--lg kc-input--pill" placeholder="Search the site" autocomplete="off" />
    </form>
    <nav class="links" aria-label="Where to go next">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </section>
</BaseLayout>
<style>
  .nf { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; padding: var(--space-7) var(--gutter); }
  .code { font-family: var(--font-title); font-weight: 500; font-size: 5rem; line-height: 1; color: var(--color-primary); }
  h1 { margin: 0; font-weight: 500; font-size: 2.25rem; }
  blockquote { margin: 0; max-inline-size: 35rem; font-family: var(--font-scripture); font-style: italic; font-size: 1.3125rem; color: color-mix(in srgb, var(--color-text) 53%, var(--color-muted)); }
  cite { display: block; margin-block-start: 6px; font-family: var(--font-body); font-style: normal; font-size: 13px; letter-spacing: 0.1em; font-variant: small-caps; font-weight: 700; color: var(--color-muted); }
  .find { inline-size: 100%; max-inline-size: 32.5rem; }
  .find input { inline-size: 100%; }
  .note { margin: 0; color: var(--color-muted); }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-4) 28px; margin-block-start: var(--space-2); }
  .links a { font-weight: 600; text-decoration: underline; text-decoration-color: var(--color-gold); text-decoration-thickness: 2px; text-underline-offset: 5px; }
  @media (min-width: 48rem) {
    .nf { padding-block: 6rem; }
    .code { font-size: 7.5rem; }
    h1 { font-size: 3rem; }
  }
</style>
