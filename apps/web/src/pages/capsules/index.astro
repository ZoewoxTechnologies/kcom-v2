---
import { lagosMonth } from "@kcom/content";
import { getArchiveStartYear } from "../../lib/archive-start";
import { monthForYear, monthPath } from "../../lib/archive";

const current = lagosMonth();
const year = Number(Astro.url.searchParams.get("year"));
return Astro.redirect(
  monthPath(
    (Number.isInteger(year) && monthForYear(year, current, await getArchiveStartYear())) || current,
  ),
  302,
);
---
