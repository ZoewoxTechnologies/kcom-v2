---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArchiveHeader from "../../../components/ArchiveHeader.astro";
import SelectForm from "../../../components/SelectForm.astro";
import CapsuleRow from "../../../components/CapsuleRow.astro";
import { data } from "../../../lib/data";
import { dayParts, lagosMonth, monthKey, monthLabel, monthShort, shiftMonth } from "@kcom/content";
import {
  archiveYears,
  capsulePath,
  monthPath,
  parseMonth,
  plural,
  archiveIntro,
} from "../../../lib/archive";
import { getArchiveStartYear } from "../../../lib/archive-start";

const current = lagosMonth();
const startYear = await getArchiveStartYear();
const month = parseMonth(Astro.params.month, current, startYear);
if (!month) return Astro.rewrite("/404");
const capsules = await data.listCapsulesInMonth(month.key);
const label = monthLabel(month.key);
const prev = month.key > monthKey(startYear, 1) ? shiftMonth(month.key, -1) : null;
const next = month.key < current ? shiftMonth(month.key, 1) : null;
const months = Array.from({ length: 12 }, (_, i) => ({
  n: i + 1,
  key: monthKey(month.year, i + 1),
}));
---

<BaseLayout
  title={`Capstone Capsules, ${label}`}
  description={`Every Capstone Capsule published in ${label}.`}
  current="/capsules"
>
  <ArchiveHeader tab="month" intro={archiveIntro(startYear)} />
  <div class="layout">
    <nav class="months" aria-label="Months">
      <SelectForm
        name="year"
        label="Year"
        inline="phone"
        action="/capsules"
        options={archiveYears(current, startYear).map((y) => ({ value: y, label: y }))}
        value={month.year}
      />
      <ul class="grid">
        {months.map((m) => (
          <li>
            {m.key > current ? (
              <span class="m future" aria-disabled="true">
                {monthShort(m.n)}
              </span>
            ) : (
              <a
                class="m"
                href={monthPath(m.key)}
                aria-current={m.key === month.key ? "page" : undefined}
              >
                {monthShort(m.n)}
              </a>
            )}
          </li>
        ))}
      </ul>
      <span class="note">Months ahead of today are not shown.</span>
    </nav>
    <section class="list" aria-label={label}>
      <div class="heading">
        <h2>{label}</h2>
        <span>{plural(capsules.length, "capsule")}</span>
      </div>
      {capsules.length === 0 && <p class="empty">No capsules were published this month.</p>}
      {capsules.map((c) => {
        const d = dayParts(c.displayDate);
        return (
          <CapsuleRow
            href={capsulePath(c.slug)}
            kicker={d.dow}
            figure={d.n}
            title={c.title}
            meta={c.scriptureRef}
            badge={c.seriesTitle}
          />
        );
      })}
      <div class="steps">
        {prev && <a href={monthPath(prev)}>← {monthLabel(prev)}</a>}
        {next && (
          <a class="next" href={monthPath(next)}>
            {monthLabel(next)} →
          </a>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  // Centre the selected month in the scrolling chip row (phone). Chip widths change when web
  // fonts arrive, so centre again once they have loaded.
  const grid = document.querySelector<HTMLElement>(".grid");
  const centre = () => {
    const chip = grid?.querySelector<HTMLElement>("[aria-current]");
    if (!grid || !chip) return;
    const g = grid.getBoundingClientRect();
    const c = chip.getBoundingClientRect();
    grid.scrollLeft += c.left - g.left - (g.width - c.width) / 2;
  };
  centre();
  document.fonts?.ready.then(centre);
  window.addEventListener("load", centre);
</script>
<style>
  .layout {
    inline-size: 100%;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-7);
    padding-block: var(--space-4) var(--space-8);
  }
  .months {
    flex: 1 1 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    min-inline-size: 0;
  }
  .months :global(.select-form) {
    flex: none;
  }
  .months :global(select) {
    min-inline-size: 6.5rem;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    white-space: nowrap;
    flex: 1;
    min-inline-size: 0;
    padding-block: 2px;
  }
  .m {
    display: block;
    padding: var(--space-2) 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
  }
  a.m:hover {
    background: var(--color-hover);
  }
  .m[aria-current] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .m.future {
    color: var(--color-line);
    border-color: transparent;
    background: transparent;
  }
  .note {
    display: none;
    font-size: 13px;
    color: var(--color-muted);
  }
  .list {
    flex: 999 1 100%;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
  }
  .heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-block-end: var(--space-3);
  }
  h2 {
    margin: 0;
    font-size: 1.75rem;
  }
  .heading span {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .empty {
    color: var(--color-muted);
  }
  .steps {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-start: var(--space-5);
    border-block-start: 1px solid var(--color-line);
    padding-block-start: var(--space-4);
  }
  .steps a {
    font-weight: 600;
    text-underline-offset: 5px;
  }
  .next {
    margin-inline-start: auto;
  }
  @media (min-width: 48rem) {
    .layout {
      padding-block-start: 2.5rem;
      gap: var(--space-7);
    }
    .months {
      flex: 1 1 220px;
      max-inline-size: 260px;
      align-self: flex-start;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-4);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }
    .m {
      padding: 10px 0;
      border-radius: var(--radius-field);
      font-size: 0.9375rem;
    }
    .note {
      display: block;
    }
    .list {
      flex-basis: 560px;
    }
    h2 {
      font-size: 2.5rem;
    }
    .steps {
      border: 0;
      padding: 0;
      margin-block-start: var(--space-5);
    }
  }
</style>
