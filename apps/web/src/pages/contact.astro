---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/design.css";
import { contactRows, contactSettings, topics } from "../lib/contact";

const rows = contactRows(contactSettings);
const social = contactSettings.social;
const defaultTopic = "question";
---
<BaseLayout title="Contact Us" description="Send Kingdom Capstone Outreach Ministries a question, testimony or prayer request." current="/contact">
  <div class="page">
    <header class="hero">
      <h1>Contact Us</h1>
      <p>A question, a testimony or a prayer request: we read every message and reply within a few days.</p>
    </header>
    <div class="body">
      <form id="contact-form" novalidate>
        <fieldset class="kc-fieldset" aria-describedby="topic-error">
          <legend>I’m writing about</legend>
          {topics.map((t) => (
            <label class="kc-choice kc-choice--pill"><input type="radio" name="topic" value={t.value} checked={t.value === defaultTopic} data-message={t.message} />{t.label}</label>
          ))}
        </fieldset>
        <p id="topic-error" class="kc-field__error" hidden></p>
        <div class="two">
          <div class="kc-field">
            <label class="kc-label" for="c-name">Your name</label>
            <input class="kc-input" id="c-name" name="name" type="text" autocomplete="name" required />
            <p class="kc-field__error" id="c-name-error" hidden></p>
          </div>
          <div class="kc-field">
            <label class="kc-label" for="c-email">Email address</label>
            <input class="kc-input" id="c-email" name="email" type="email" autocomplete="email" required />
            <p class="kc-field__error" id="c-email-error" hidden></p>
          </div>
        </div>
        <div class="kc-field">
          <label class="kc-label" for="c-message" id="c-message-label">Your question</label>
          <textarea class="kc-textarea" id="c-message" name="message" rows="6" required></textarea>
          <p class="kc-field__error" id="c-message-error" hidden></p>
        </div>
        <label class="kc-choice" id="private-row" hidden><input type="checkbox" name="private" checked />Keep my request private to the prayer team</label>
        <div class="actions">
          <button class="kc-btn kc-btn--primary kc-btn--sm" type="submit" disabled>Send message</button>
          <span class="note">Sending opens soon. For now, please use the contact details alongside.</span>
        </div>
      </form>
      <aside>
        <div class="card">
          <h2>Other ways to reach us</h2>
          {rows.map((r) => <span><strong>{r.label}</strong><br />{r.value}</span>)}
          {social.length > 0 && <span class="social">{social.map((s) => <a href={s.href}>{s.label}</a>)}</span>}
        </div>
        <div class="success" role="status" id="contact-success" hidden>
          <span class="thanks">Thank you, <span id="success-name"></span>.</span>
          <span class="msg">Your message is with our team. We will reply within a few days.</span>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
<script>
  import { validateContact } from "../lib/contact";
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
  const keys = ["topic", "name", "email", "message"] as const;
  const errEl = (k: string) => document.getElementById(k === "topic" ? "topic-error" : `c-${k}-error`)!;
  const values = () => ({
    topic: (form.querySelector<HTMLInputElement>('input[name="topic"]:checked')?.value) ?? "",
    name: field("name").value, email: field("email").value, message: field("message").value,
  });
  function show(k: (typeof keys)[number], msg?: string) {
    const el = errEl(k);
    el.hidden = !msg;
    el.textContent = msg ?? "";
    if (k !== "topic") {
      const input = field(k);
      if (msg) { input.setAttribute("aria-invalid", "true"); input.setAttribute("aria-describedby", el.id); }
      else { input.removeAttribute("aria-invalid"); input.removeAttribute("aria-describedby"); }
    }
  }
  const check = (k: (typeof keys)[number]) => show(k, validateContact(values())[k]);
  for (const k of ["name", "email", "message"] as const) {
    field(k).addEventListener("blur", () => check(k));
    field(k).addEventListener("input", () => field(k).hasAttribute("aria-invalid") && check(k));
  }
  const label = document.getElementById("c-message-label")!;
  const priv = document.getElementById("private-row")!;
  form.querySelectorAll<HTMLInputElement>('input[name="topic"]').forEach((r) =>
    r.addEventListener("change", () => {
      label.textContent = r.dataset.message ?? "Your message";
      priv.hidden = r.value !== "prayer";
      check("topic");
    }),
  );
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const errors = validateContact(values());
    keys.forEach((k) => show(k, errors[k]));
    const first = keys.find((k) => errors[k]);
    if (first) { (first === "topic" ? form.querySelector<HTMLInputElement>('input[name="topic"]') : field(first))?.focus(); return; }
    // The send request is wired up with the email provider; until then the button stays disabled.
    document.getElementById("success-name")!.textContent = values().name.trim().split(/\s+/)[0];
    document.getElementById("contact-success")!.hidden = false;
  });
</script>
<style>
  .page { font-size: 17px; line-height: 1.65; display: flex; flex-direction: column; margin-block-end: calc(var(--space-6) * -1); }
  .hero { display: flex; flex-direction: column; gap: 10px; background: var(--color-wash); box-shadow: 0 0 0 100vmax var(--color-wash); clip-path: inset(0 -100vmax); margin-block-start: calc(var(--space-6) * -1); padding-block: 56px; }
  .hero h1 { margin: 0; font-family: var(--font-title); font-weight: 500; font-size: 60px; line-height: 1.05; }
  .hero p { margin: 0; max-inline-size: 640px; font-size: 19px; }
  .body { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; padding-block: 48px 72px; }
  form { flex: 3 1 520px; min-inline-size: 0; background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 14px; padding: 36px; display: flex; flex-direction: column; gap: 18px; box-sizing: border-box; }
  form .kc-fieldset { gap: 10px; }
  legend { font-size: 14px; font-weight: 700; margin-block-end: 8px; line-height: 1.65; }
  .kc-choice--pill { font-size: 15px; line-height: 1.65; }
  .two { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }
  .kc-field { gap: 6px; }
  .kc-label { line-height: 1.65; }
  .kc-field__error { color: var(--color-error); font-size: 14px; line-height: 1.65; }
  #topic-error { margin-block-start: -10px; }
  .kc-input, .kc-textarea { color: var(--d-input-text); border-color: var(--d-field-line); }
  .kc-input:focus-visible, .kc-textarea:focus-visible { border-color: var(--color-primary); }
  .kc-input[aria-invalid="true"] { border-color: var(--color-error); transition: none; }
  .kc-input { block-size: auto; padding: 12px 14px; line-height: 1.4; font-size: 16px; }
  .kc-input[aria-invalid="true"] { padding: 11.5px 13.5px; }
  .kc-textarea { min-block-size: 0; font-size: 16px; }
  #private-row { min-block-size: 0; gap: 10px; font-size: 15px; line-height: 1.65; }
  #private-row[hidden], [hidden] { display: none; }
  .actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .note { font-size: 13px; color: var(--color-muted); line-height: 1.65; }
  aside { flex: 2 1 300px; min-inline-size: 0; display: flex; flex-direction: column; gap: 20px; }
  .card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 14px; padding: 28px; display: flex; flex-direction: column; gap: 10px; font-size: 16px; }
  .card h2 { margin: 0; font-family: var(--font-title); font-weight: 600; font-size: 28px; line-height: 1.65; }
  .social { display: flex; gap: 16px; }
  .card a { text-decoration-color: currentColor; }
  .success { background: var(--d-cover-3); border: 1px solid #9dbfa5; border-radius: 14px; padding: 24px; display: flex; flex-direction: column; gap: 6px; }
  .thanks { font-family: var(--font-title); font-weight: 600; font-size: 24px; }
  .msg { font-size: 15px; }
  @media (max-width: 47.99rem) { .hero h1 { font-size: 40px; } .hero p { font-size: 18px; } form { padding: 24px; } }
  @media (min-width: 48rem) { .two { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
