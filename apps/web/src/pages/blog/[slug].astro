---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import CardGrid from "../../components/CardGrid.astro";
import SignupBand from "../../components/SignupBand.astro";
import { data } from "../../lib/data";
import { postKicker, readingMinutes, relatedPosts } from "../../lib/blog";
import { richTextToPlain } from "../../lib/data/client";
import { richTextToHtml } from "../../lib/rich-text";

const { slug } = Astro.params;
const post = slug ? await data.blogPostBySlug(slug) : null;
if (!post) return Astro.rewrite("/404");
const related = await relatedPosts(data, post);
const html = richTextToHtml(post.body);
const description = post.excerpt ?? (richTextToPlain(post.body).slice(0, 160) || undefined);
Astro.response.headers.set("cache-control", "public, max-age=0, s-maxage=300");
---
<BaseLayout title={post.title} description={description} current="/blog">
  <article class="post">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/blog">Blog</a>{post.tags[0] && <> / {post.tags[0]}</>}
    </nav>
    <span class="kicker">{postKicker(post)}</span>
    <h1>{post.title}</h1>
    <p class="meta">{readingMinutes(post.body)} min read</p>
    {post.heroImageUrl && <img class="hero" src={post.heroImageUrl} alt="" />}
    <div class="prose" set:html={html} />
    {post.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">{post.tags.map((t) => <li>{t}</li>)}</ul>
    )}
  </article>
  <div class="narrow"><SignupBand /></div>
  {related.length > 0 && (
    <section class="more" aria-labelledby="more-title">
      <h2 id="more-title">More from the blog</h2>
      <CardGrid>{related.map((r) => <BlogCard post={r} />)}</CardGrid>
    </section>
  )}
</BaseLayout>
<style>
  .post, .narrow { max-inline-size: 45rem; margin-inline: auto; }
  .post { display: flex; flex-direction: column; gap: 1.4rem; padding-block: var(--space-5) var(--space-6); font-size: 1.0625rem; line-height: 1.7; }
  .crumbs { font-size: var(--text-sm); color: var(--color-muted); }
  .kicker { font-size: 0.8125rem; letter-spacing: 0.1em; font-variant: small-caps; font-weight: 700; color: var(--color-gold-text); }
  h1 { margin: -0.5rem 0 0; font-family: var(--font-title); font-weight: 500; line-height: 1.05; }
  .meta { margin: 0; font-size: var(--text-sm); color: var(--color-muted); }
  .hero { inline-size: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); display: block; background: var(--color-wash); }
  .prose { display: flex; flex-direction: column; gap: 1.25rem; }
  .prose :global(p) { margin: 0; }
  .prose :global(p:first-child) { font-size: 1.1875rem; line-height: 1.6; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { margin: var(--space-3) 0 0; font-family: var(--font-title); font-weight: 600; line-height: 1.15; }
  .prose :global(h2) { font-size: 1.75rem; }
  .prose :global(h3) { font-size: 1.4rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-inline-start: 1.4rem; }
  .prose :global(a) { color: var(--color-primary); }
  .prose :global(blockquote) { margin: var(--space-2) 0; border-inline-start: 3px solid var(--color-gold); padding: var(--space-1) 0 var(--space-1) var(--space-4); font-family: var(--font-scripture); font-style: italic; font-size: 1.1875rem; line-height: 1.5; }
  .prose :global(blockquote p) { margin: 0; }
  /* A closing paragraph in a quote is its reference. */
  .prose :global(blockquote p:last-child:not(:first-child)) { margin-block-start: 6px; font-family: var(--font-body); font-style: normal; font-size: 0.8125rem; letter-spacing: 0.1em; font-variant: small-caps; font-weight: 700; color: var(--color-gold-text); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: 0; padding: 0; list-style: none; font-size: var(--text-sm); font-weight: 600; line-height: 1.4; }
  .tags li { padding: 6px 12px; border-radius: var(--radius-pill); background: var(--color-wash); }
  .more { display: flex; flex-direction: column; gap: var(--space-5); padding-block: var(--space-7) var(--space-6); }
  .more h2 { margin: 0; font-family: var(--font-title); font-weight: 600; font-size: 1.75rem; }
  @media (min-width: 48rem) {
    .post { font-size: 1.0625rem; gap: 1.5rem; padding-block: var(--space-7) var(--space-6); }
    .prose :global(blockquote) { font-size: 1.375rem; }
    .prose :global(h2) { font-size: 2.125rem; }
    .more h2 { font-size: 2.25rem; }
  }
</style>
