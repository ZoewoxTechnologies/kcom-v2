---
import ResponsiveImage from "./ResponsiveImage.astro";
/**
 * The photographic layer behind a banner: a section photo (or an item's own image) under the
 * shared teal wash. The parent must be `position: relative; isolation: isolate` and clip the
 * overflow. `flip` puts the strong wash on the right, for content that sits on that side.
 */
export type BannerSection =
  "home" | "capsules" | "events" | "blog" | "about" | "books" | "partner" | "contact" | "privacy";
interface Props {
  section: BannerSection;
  /** An item's own image; the section photo is the fallback. */
  image?: string | null;
  flip?: boolean;
  /** "hero" is the lighter, more natural grade for the home page: the photo is only darkened behind the text. */
  variant?: "section" | "hero";
}
const { section, image, flip = false, variant = "section" } = Astro.props;
const photo = `/banners/${section}`;
---

<div class:list={["art", { flip, hero: variant === "hero" }]} aria-hidden="true">
  {image ? (
    <ResponsiveImage
      src={image}
      widths={[640, 1024, 1600]}
      ratio={1600 / 450}
      sizes="100vw"
      eager
    />
  ) : (
    <picture>
      <source
        type="image/avif"
        srcset={`${photo}-800.avif 800w, ${photo}-1600.avif 1600w`}
        sizes="100vw"
      />
      <source
        type="image/webp"
        srcset={`${photo}-800.webp 800w, ${photo}-1600.webp 1600w`}
        sizes="100vw"
      />
      <img src={`${photo}-1600.webp`} width="1600" height="450" alt="" fetchpriority="high" />
    </picture>
  )}
  <span class="grain"></span>
</div>
<style>
  .art {
    position: absolute;
    inset-block: 0;
    inset-inline: calc(50% - 50vw);
    z-index: -1;
    background: linear-gradient(100deg, var(--banner-start), var(--banner-end));
  }
  .art img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 85% 50%;
  }
  /* shared photo grade: a strong teal wash on the text side, easing out to the right */
  .art::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--banner-start) 94%, transparent) 0%,
      color-mix(in srgb, var(--banner-end) 78%, transparent) 48%,
      color-mix(in srgb, var(--banner-end) 30%, transparent) 100%
    );
  }
  .art::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--banner-end);
    mix-blend-mode: color;
    opacity: 0.55;
  }
  :root[data-theme="dark"] .art img {
    filter: brightness(0.7);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .art img {
      filter: brightness(0.7);
    }
  }
  .grain {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    mix-blend-mode: overlay;
    z-index: 2;
  }
  /* on phones the text spans the whole width, so the wash is even rather than a left-to-right fade */
  @media (max-width: 47.99rem) {
    .art::before,
    .art.flip::before {
      background: color-mix(in srgb, var(--banner-start) 82%, transparent);
      transform: none;
    }
  }
  .art.flip::before {
    transform: scaleX(-1);
  }
  /* Hero grade: no colour blend or grain, just a vignette from the text side. The parent sets
     --copy-reach, how far the copy extends from the text side; the wash stays strong across all
     of it (AA for the text) and fades out beyond, so the photo reads as a photo. */
  .art.hero {
    --hw-near: color-mix(in srgb, var(--banner-start) var(--hw-strong), transparent);
    --hw-far: color-mix(in srgb, var(--hw-far-colour) var(--hw-fade), transparent);
    --hw-end: color-mix(in srgb, var(--hw-far-colour) 0%, transparent);
    --hw-strong: 86%;
    --hw-fade: 8%;
    --hw-far-colour: var(--banner-end);
    --hw-floor: color-mix(in srgb, var(--banner-start) 18%, transparent);
    --hw-floor-from: 70%;
    --hw-filter: saturate(1.05) contrast(1.04);
  }
  .art.hero::before {
    background:
      linear-gradient(
        90deg,
        var(--hw-near) 0%,
        var(--hw-near) var(--copy-reach, 48%),
        var(--hw-far) calc(var(--copy-reach, 48%) + 30%),
        var(--hw-end) 100%
      ),
      linear-gradient(180deg, transparent var(--hw-floor-from), var(--hw-floor));
  }
  .art.hero::after,
  .art.hero .grain {
    display: none;
  }
  .art.hero img {
    filter: var(--hw-filter);
  }
  /* a deeper, richer grade in dark mode */
  :root[data-theme="dark"] .art.hero {
    --hw-strong: 92%;
    --hw-fade: 30%;
    --hw-far-colour: var(--banner-start);
    --hw-floor: var(--banner-start);
    --hw-floor-from: 60%;
    --hw-filter: brightness(0.95) saturate(1.1) contrast(1.08);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .art.hero {
      --hw-strong: 92%;
      --hw-fade: 30%;
      --hw-far-colour: var(--banner-start);
      --hw-floor: var(--banner-start);
      --hw-floor-from: 60%;
      --hw-filter: brightness(0.95) saturate(1.1) contrast(1.08);
    }
  }
  .art.flip img {
    object-position: 15% 50%;
  }
</style>
