---
import PageBanner from "./PageBanner.astro";
interface Props {
  /** Which tab is active. */
  tab: "month" | "series";
  title?: string;
  intro?: string;
}
const { tab, title = "Capstone Capsules", intro } = Astro.props;
const tabs = [
  { id: "month", label: "By month", href: "/capsules" },
  { id: "series", label: "By series", href: "/series" },
] as const;
---

<PageBanner section="capsules" title={title} intro={intro}>
  <nav class="tabs" aria-label="Browse by">
    {tabs.map((t) => (
      <a href={t.href} aria-current={t.id === tab ? "page" : undefined}>
        {t.label}
      </a>
    ))}
  </nav>
</PageBanner>
<style>
  .tabs {
    display: flex;
    gap: var(--space-5);
    font-weight: 700;
    margin-block-start: var(--space-2);
  }
  .tabs a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    padding-block: var(--space-3);
    border-block-end: 3px solid transparent;
  }
  .tabs a[aria-current] {
    color: #fff;
    border-block-end-color: #d4b46e;
  }
</style>
