---
import { footerColumns, siteName } from "../lib/site";
import { footerContact } from "../lib/footer-contact";
import { formatPhone, phoneHref } from "../lib/phone";
// The footer never fails a page: without contact details it shows only the form link.
const contact = await footerContact.get();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="cols">
    <div class="about">
      <div class="brand">
        <img src="/logo.png" alt="" width="44" height="44" />
        <span>
          Kingdom Capstone<span class="line2">Outreach Ministries</span>
        </span>
      </div>
      <div class="rule"></div>
      <p>
        He leadeth me beside the still waters.<span class="ref">Psalm 23:2</span>
      </p>
    </div>
    {footerColumns.map((c) => (
      <div class="col">
        <strong>{c.heading}</strong>
        {c.links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </div>
    ))}
    <div class="col contact">
      <strong>Contact</strong>
      {contact?.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
      {contact?.phone && <a href={phoneHref(contact.phone)}>{formatPhone(contact.phone)}</a>}
      {contact?.address && <address>{contact.address}</address>}
      <a href="/contact">Contact form</a>
    </div>
  </div>
  <div class="base">
    <span class="legal">
      <span>
        © {year} {siteName}
      </span>
      <span class="dot" aria-hidden="true">
        ·
      </span>
      <a href="/privacy">Privacy policy</a>
    </span>
    <span class="social">
      <span class="links">
        {(contact?.social ?? []).map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </span>
      <button type="button" id="theme-toggle" class="kc-btn kc-btn--secondary">
        <span class="icon" aria-hidden="true">
          ☾
        </span>{" "}
        <span class="label">Dark</span>
      </button>
    </span>
  </div>
</footer>
<script is:inline>
  (() => {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const root = document.documentElement;
    const isDark = () =>
      root.dataset.theme
        ? root.dataset.theme === "dark"
        : matchMedia("(prefers-color-scheme: dark)").matches;
    // The button offers the opposite theme: moon and "Dark" in light mode, sun and "Light" in dark mode.
    const paint = () => {
      btn.querySelector(".icon").textContent = isDark() ? "☀" : "☾";
      btn.querySelector(".label").textContent = isDark() ? "Light" : "Dark";
    };
    paint();
    btn.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      paint();
    });
  })();
</script>
<style>
  .site-footer {
    background: var(--color-footer);
    color: var(--color-on-footer);
    padding-block: var(--space-7) var(--space-5);
    padding-inline: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter)));
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .cols {
    display: grid;
    gap: var(--space-6);
    font-size: 0.9375rem;
    grid-template-columns: 1fr;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.05;
  }
  .brand :global(img) {
    width: 44px;
    height: 44px;
    object-fit: contain;
  }
  .line2 {
    display: block;
  }
  .rule {
    width: 40px;
    height: 2px;
    background: var(--color-gold);
    margin-block: var(--space-3);
  }
  .about p {
    margin: 0;
  }
  .ref {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    font-variant: small-caps;
    font-weight: 700;
    color: var(--color-footer-gold);
    margin-top: var(--space-1);
  }
  /* On phone each link keeps its full 44px tap target, so the links sit edge to edge. */
  .col {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  /* Thin gold dividers between the brand and the sections (the same gold as the rule under the logo): horizontal when stacked. */
  .cols > * + * {
    border-block-start: 1px solid var(--color-gold);
    padding-block-start: var(--space-6);
  }
  .col strong {
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-footer-gold);
    font-weight: 700;
  }
  /* Links keep the shared link style (gold underline, which changes on hover); the primary colour is unreadable on the dark footer, so hover shows the text colour. */
  .col a,
  .base a {
    color: inherit;
  }
  .col a:hover,
  .base a:hover {
    text-decoration-color: currentColor;
  }
  address {
    font-style: normal;
    overflow-wrap: anywhere;
  }
  .base {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-size: var(--text-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--space-4);
  }
  .social {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    flex-wrap: wrap;
  }
  .links {
    display: contents;
  }
  .legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1) var(--space-2);
  }
  .dot {
    display: none;
  }
  #theme-toggle .icon {
    font-size: 1em;
  }
  /* Outline button on the dark footer: a light tint on hover, so the white text and icon stay readable. */
  #theme-toggle {
    --kc-btn-fg: var(--color-on-footer);
    --kc-btn-border: rgba(255, 255, 255, 0.3);
    --color-secondary-hover: rgba(255, 255, 255, 0.12);
    --color-secondary-active: rgba(255, 255, 255, 0.2);
  }
  @media (min-width: 64rem) {
    .cols {
      grid-template-columns: 1.4fr 1fr 1fr 1.6fr;
    }
    /* Pointer screens do not need the 44px target: tighter rows (pitch 36px, about half the old gap). */
    .col {
      gap: var(--space-3);
    }
    .col a {
      min-block-size: var(--space-5);
    }
    /* Side by side: vertical dividers instead. */
    .cols > * + * {
      border-block-start: 0;
      padding-block-start: 0;
      border-inline-start: 1px solid var(--color-gold);
      padding-inline-start: var(--space-5);
    }
    .legal {
      flex-direction: row;
      align-items: baseline;
    }
    .dot {
      display: inline;
    }
    .base {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
