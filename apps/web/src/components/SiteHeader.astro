---
import Menu from "@kcom/ui/astro/Menu.astro";
import { navItems, isCurrent } from "../lib/nav";
import { siteName } from "../lib/site";
import { formatLagosDate, formatLagosShortDate } from "@kcom/content";
import { data } from "../lib/data";
const { current = "" } = Astro.props;
const capsule = await data.latestCapsule();
const today = capsule ? formatLagosDate(capsule.displayDate) : "";
const shortDate = capsule ? formatLagosShortDate(capsule.displayDate) : "";
const quote = capsule?.scriptureText ? `“${capsule.scriptureText}” ${capsule.scriptureRef ?? ""}` : (capsule?.scriptureRef ?? "");
---
{capsule && <div class="verse-bar">
  <span class="date">{today}</span>
  <a class="verse" href="/capsules/today"><span class="long">Today: {quote}</span><span class="short">{shortDate} · Today: {capsule?.scriptureRef} →</span></a>
  <a class="email" href="/subscribe">Get it by email</a>
</div>}
<header class="site-header">
  <a class="brand" href="/">
    <img src="/logo.png" alt="" width="48" height="48" />
    <span>Kingdom Capstone<span class="line2">Outreach Ministries</span></span>
    <span class="sr-only">{siteName}</span>
  </a>
  <nav class="main-nav" aria-label="Main">
    {navItems.map((item, i) =>
      item.children ? (
        <Menu id={`nav-menu-${i}`} class={isCurrent(item, current) ? "is-current" : undefined}>
          <Fragment slot="trigger">{item.label}</Fragment>
          {item.children.map((c) => <a class="kc-menu__item" role="menuitem" href={c.href}>{c.label}</a>)}
        </Menu>
      ) : (
        <a href={item.href} aria-current={isCurrent(item, current) ? "page" : undefined}>{item.label}</a>
      ),
    )}
  </nav>
  <details class="menu">
    <summary class="kc-btn kc-btn--secondary kc-btn--sm">Menu</summary>
    <nav aria-label="Main mobile">
      {navItems.map((item) =>
        item.children ? (
          <details class="group" open={isCurrent(item, current) || undefined}>
            <summary>{item.label}</summary>
            <div class="sub">
              {item.children.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          </details>
        ) : (
          <div class="group">
            <a href={item.href} aria-current={isCurrent(item, current) ? "page" : undefined}>{item.label}</a>
          </div>
        ),
      )}
    </nav>
  </details>
  <a class="search" href="/search" aria-label="Search">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
  </a>
  <a class="cta kc-btn kc-btn--primary kc-btn--sm" href="/capsules/today">Today’s Capsule</a>
</header>
<style>
  .verse-bar { background: var(--color-bar); color: var(--color-on-bar); padding: var(--space-2) var(--gutter); display: flex; gap: var(--space-4); align-items: center; font-size: var(--text-sm); }
  .verse-bar .date { font-variant: small-caps; letter-spacing: 0.1em; font-weight: 700; color: var(--color-bar-gold); }
  .verse-bar .verse { color: inherit; text-decoration: none; font-family: var(--font-title); font-style: italic; font-size: var(--text-lg); }
  .verse-bar .email { margin-left: auto; color: inherit; text-decoration: underline; text-decoration-color: var(--color-gold); text-underline-offset: 4px; white-space: nowrap; }
  .site-header { position: sticky; top: 0; z-index: 10; background: var(--color-header); border-bottom: 1px solid var(--color-line); padding: var(--space-3) var(--gutter); display: flex; align-items: center; gap: var(--space-4); }
  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--color-text); text-decoration: none; font-family: var(--font-title); font-weight: 600; font-size: 1.125rem; line-height: 1.05; }
  .brand :global(img) { width: 38px; height: 38px; object-fit: contain; }
  .line2 { display: block; }
  .main-nav { display: none; align-items: center; gap: var(--space-5); margin-left: auto; white-space: nowrap; font-weight: 600; font-size: 0.9375rem; }
  .main-nav a, .menu nav a { color: var(--color-text); text-decoration: none; padding: var(--space-2) 0; border-bottom: 2px solid transparent; }
  .main-nav a[aria-current="page"] { border-bottom-color: var(--color-gold); }
  .search { inline-size: 44px; block-size: 44px; border-radius: var(--radius-pill); border: 1px solid var(--color-line); color: var(--color-text); align-items: center; justify-content: center; flex: none; }
  .search:hover { background: var(--color-hover); }
  .menu { margin-left: auto; position: relative; }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu nav { position: absolute; right: 0; top: calc(100% + var(--space-2)); width: min(18rem, 85vw); background: var(--color-raised); border: 1px solid var(--color-line); border-radius: var(--radius); box-shadow: var(--shadow-menu); padding: var(--space-3) var(--space-4); display: flex; flex-direction: column; font-family: var(--font-title); font-size: 1.375rem; max-height: calc(100dvh - 8rem); overflow-y: auto; }
  .main-nav :global(.kc-menu-wrap.is-current .kc-menu-trigger) { border-bottom: 2px solid var(--color-gold); border-radius: 0; }
  .main-nav :global(.kc-menu-trigger) { font-weight: 600; font-size: 0.9375rem; color: var(--color-text); }
  .menu summary.kc-btn { display: inline-flex; }
  .menu details.group > summary { list-style: none; display: flex; align-items: center; justify-content: space-between; cursor: pointer; padding: 0; }
  .menu details.group > summary::-webkit-details-marker { display: none; }
  .menu details.group > summary::after { content: ""; margin-inline-end: 0.2em; inline-size: 0.5em; block-size: 0.5em; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: translateY(-0.1em) rotate(45deg); transition: transform var(--dur-fast) var(--ease-out); }
  .menu details.group[open] > summary::after { transform: translateY(0.1em) rotate(-135deg); }
  .menu .group { border-bottom: 1px solid var(--color-line); padding: var(--space-1) 0; }
  .menu .group:last-child { border-bottom: 0; }
  .menu .sub { display: flex; flex-direction: column; padding: 0 0 var(--space-2) var(--space-3); line-height: 1.3; font-family: var(--font-body); font-size: 0.9375rem; color: var(--color-muted); }
  .menu .sub a { color: inherit; padding: var(--space-2) 0; }
  .verse .short { display: inline; }
  .verse .long { display: none; }
  .cta, .search { display: none; }
  .verse-bar .date, .verse-bar .email { display: none; }
  .verse-bar .verse { font-size: var(--text-base); }
  @media (min-width: 64rem) {
    .site-header { padding-block: var(--space-4); }
    .brand { font-size: 1.375rem; }
    .brand :global(img) { width: 48px; height: 48px; }
    .main-nav { display: flex; }
    .menu { display: none; }
    .cta { display: inline-flex; }
    .search { display: flex; }
    .verse-bar .date { display: inline; }
    .verse-bar .email { display: inline; }
    .verse-bar .verse { font-size: var(--text-lg); }
    .verse .short { display: none; }
    .verse .long { display: inline; }
  }
</style>
