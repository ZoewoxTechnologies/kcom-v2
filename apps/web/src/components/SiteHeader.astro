---
import Menu from "@kcom/ui/astro/Menu.astro";
import { navItems, isCurrent } from "../lib/nav";
import { siteName } from "../lib/site";
import { formatLagosDate, formatLagosShortDate, lagosDate } from "@kcom/content";
import { data } from "../lib/data";
import { quoteVerse } from "../lib/verse";
import { todaysCapsule } from "../lib/today";
import { richTextToPlain } from "../lib/data/client";
const { current = "" } = Astro.props;
const todayKey = lagosDate(new Date());
const capsule = await todaysCapsule(data, todayKey);
const label = capsule?.displayDate === todayKey ? "Today" : "Latest";
const today = capsule ? formatLagosDate(capsule.displayDate) : "";
const shortDate = capsule ? formatLagosShortDate(capsule.displayDate) : "";
const scriptureText = capsule ? richTextToPlain(capsule.scriptureText) : "";
const quote = scriptureText
  ? `${quoteVerse(scriptureText)} ${capsule?.scriptureRef ?? ""}`
  : (capsule?.scriptureRef ?? "");
---

{capsule && (
  <div class="verse-bar">
    <span class="date">{today}</span>
    <a class="verse" href="/capsules/today">
      <span class="long">
        {label}: {quote}
      </span>
      <span class="short">
        {shortDate} · {label}: {capsule?.scriptureRef} →
      </span>
    </a>
    <a class="email" href="/subscribe">
      Get it by email
    </a>
  </div>
)}
<header class="site-header">
  <a class="brand" href="/">
    <img src="/logo.png" alt="" width="48" height="48" />
    <span>
      Kingdom Capstone<span class="line2">Outreach Ministries</span>
    </span>
    <span class="sr-only">{siteName}</span>
  </a>
  <nav class="main-nav" aria-label="Main">
    {navItems.map((item, i) =>
      item.children ? (
        <Menu id={`nav-menu-${i}`} class={isCurrent(item, current) ? "is-current" : undefined}>
          <Fragment slot="trigger">{item.label}</Fragment>
          {item.children.map((c) => (
            <a class="kc-menu__item" role="menuitem" href={c.href}>
              {c.label}
            </a>
          ))}
        </Menu>
      ) : (
        <a href={item.href} aria-current={isCurrent(item, current) ? "page" : undefined}>
          {item.label}
        </a>
      ),
    )}
  </nav>
  <details class="menu">
    <summary class="menu-toggle" role="button" aria-label="Open menu" aria-expanded="false">
      <svg
        class="icon-open"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg
        class="icon-close"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </summary>
    <nav class="kc-slide-in" aria-label="Main mobile">
      {navItems.map((item) =>
        item.children ? (
          <details class="group" open={isCurrent(item, current) || undefined}>
            <summary>{item.label}</summary>
            <div class="sub">
              {item.children.map((c) => (
                <a href={c.href}>{c.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <div class="group">
            <a href={item.href} aria-current={isCurrent(item, current) ? "page" : undefined}>
              {item.label}
            </a>
          </div>
        ),
      )}
    </nav>
  </details>
  <a class="search" href="/search" aria-label="Search">
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
  </a>
  <a class="cta kc-btn kc-btn--primary" href="/capsules/today">
    Today’s Capsule
  </a>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>("details.menu").forEach((d) => {
    const toggle = d.querySelector("summary.menu-toggle");
    d.addEventListener("toggle", () => {
      toggle?.setAttribute("aria-expanded", String(d.open));
      toggle?.setAttribute("aria-label", d.open ? "Close menu" : "Open menu");
    });
  });
</script>
<style>
  .verse-bar {
    background: var(--color-bar);
    color: var(--color-on-bar);
    padding-block: var(--space-2);
    padding-inline: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter)));
    display: flex;
    gap: var(--space-4);
    align-items: center;
    font-size: var(--text-sm);
  }
  .verse-bar .date {
    font-variant: small-caps;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-bar-gold);
  }
  .verse-bar .verse {
    color: inherit;
    text-decoration: none;
    font-family: var(--font-title);
    font-style: italic;
    font-size: var(--text-lg);
  }
  .verse-bar .email {
    margin-left: auto;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
    text-underline-offset: 4px;
    white-space: nowrap;
  }
  .verse-bar .email:hover {
    text-decoration-color: currentColor;
    text-decoration-thickness: 2px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-header);
    border-bottom: 1px solid var(--color-line);
    padding-block: var(--space-3);
    padding-inline: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter)));
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.05;
  }
  .brand :global(img) {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }
  .line2 {
    display: block;
  }
  .main-nav {
    display: none;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
    white-space: nowrap;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .main-nav a,
  .menu nav a {
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-bottom: 2px solid transparent;
  }
  .main-nav a[aria-current="page"] {
    border-bottom-color: var(--color-gold);
  }
  .search {
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    color: var(--color-text);
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .search:hover {
    background: var(--color-hover);
  }
  .menu {
    margin-left: auto;
    position: relative;
  }
  .menu summary {
    list-style: none;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-2));
    width: min(18rem, 85vw);
    background: var(--color-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-menu);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    font-family: var(--font-title);
    font-size: 1.375rem;
    max-height: calc(100dvh - 8rem);
    overflow-y: auto;
  }
  .main-nav :global(.kc-menu-wrap.is-current .kc-menu-trigger) {
    border-bottom: 2px solid var(--color-gold);
    border-radius: 0;
  }
  .main-nav :global(.kc-menu-trigger) {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }
  .menu .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--radius-pill);
    color: var(--color-text);
    cursor: pointer;
    margin-inline-end: calc(var(--space-2) * -1);
  }
  .menu .menu-toggle:hover {
    background: var(--color-hover);
  }
  .menu .icon-close,
  .menu[open] .icon-open {
    display: none;
  }
  .menu[open] .icon-close {
    display: block;
  }
  .menu details.group > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 0;
  }
  .menu details.group > summary::-webkit-details-marker {
    display: none;
  }
  .menu details.group > summary::after {
    content: "";
    margin-inline-end: 0.2em;
    inline-size: 0.5em;
    block-size: 0.5em;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: translateY(-0.1em) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .menu details.group[open] > summary::after {
    transform: translateY(0.1em) rotate(-135deg);
  }
  .menu .group {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-1) 0;
  }
  .menu .group:last-child {
    border-bottom: 0;
  }
  .menu .sub {
    display: flex;
    flex-direction: column;
    padding: 0 0 var(--space-2) var(--space-3);
    line-height: 1.3;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .menu .sub a {
    color: inherit;
    padding: var(--space-2) 0;
  }
  .verse-bar .verse {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--touch-target);
  }
  .verse-bar {
    padding-block: 0;
  }
  .brand {
    min-block-size: var(--touch-target);
  }
  .menu nav a,
  .menu details.group > summary {
    min-block-size: var(--touch-target);
    display: flex;
    align-items: center;
    padding-block: 0;
  }
  .menu .sub a {
    min-block-size: var(--touch-target);
    display: flex;
    align-items: center;
    padding-block: 0;
  }
  .verse .short {
    display: inline;
  }
  .verse .long {
    display: none;
  }
  .cta,
  .search {
    display: none;
  }
  .verse-bar .date,
  .verse-bar .email {
    display: none;
  }
  .verse-bar .verse {
    font-size: var(--text-base);
  }
  /* the full nav needs about 76rem; below that the menu button keeps the header on one row */
  @media (min-width: 76rem) {
    .site-header {
      padding-block: var(--space-4);
    }
    .brand {
      font-size: 1.375rem;
    }
    .brand :global(img) {
      width: 50px;
      height: 50px;
    }
    .main-nav {
      display: flex;
    }
    .menu {
      display: none;
    }
    .cta {
      display: inline-flex;
    }
    .search {
      display: flex;
    }
  }
  @media (min-width: 64rem) {
    .verse-bar .date {
      display: inline;
    }
    .verse-bar .email {
      display: inline;
    }
    .verse-bar .verse {
      font-size: 1.0625rem;
    }
    .verse .short {
      display: none;
    }
    .verse .long {
      display: inline;
    }
  }
</style>
