---
import { navLinks, ministryName } from "../lib/site";
const { current = "" } = Astro.props;
---
<div class="verse-bar">
  <span class="date">Today</span>
  <span class="verse">Verse of the day placeholder</span>
  <a class="email" href="/subscribe">Get it by email</a>
</div>
<header class="site-header">
  <a class="brand" href="/">
    <img src="/logo.png" alt="" width="48" height="48" />
    <span>Kingdom Capstone<span class="line2">Outreach Ministries</span></span>
    <span class="sr-only">{ministryName}</span>
  </a>
  <nav class="main-nav" aria-label="Main">
    {navLinks.map((l) => <a href={l.href} aria-current={current === l.href ? "page" : undefined}>{l.label}</a>)}
  </nav>
  <details class="menu">
    <summary>Menu</summary>
    <nav aria-label="Main mobile">
      {navLinks.map((l) => <a href={l.href} aria-current={current === l.href ? "page" : undefined}>{l.label}</a>)}
    </nav>
  </details>
  <a class="cta" href="/capsules/today">Today’s Capsule</a>
</header>
<style>
  .verse-bar { background: var(--color-bar); color: var(--color-on-bar); padding: var(--space-2) var(--gutter); display: flex; gap: var(--space-4); align-items: center; font-size: var(--text-sm); }
  .verse-bar .date { font-variant: small-caps; letter-spacing: 0.1em; font-weight: 700; color: var(--color-bar-gold); }
  .verse-bar .verse { font-family: var(--font-title); font-style: italic; font-size: var(--text-lg); }
  .verse-bar .email { margin-left: auto; color: inherit; text-decoration: underline; text-decoration-color: var(--color-gold); text-underline-offset: 4px; white-space: nowrap; }
  .site-header { position: sticky; top: 0; z-index: 10; background: var(--color-header); border-bottom: 1px solid var(--color-line); padding: var(--space-3) var(--gutter); display: flex; align-items: center; gap: var(--space-4); }
  .brand { display: flex; align-items: center; gap: var(--space-3); color: var(--color-text); text-decoration: none; font-family: var(--font-title); font-weight: 600; font-size: 1.125rem; line-height: 1.05; }
  .brand img { width: 38px; height: 38px; object-fit: contain; }
  .line2 { display: block; }
  .main-nav { display: none; gap: var(--space-5); margin-left: auto; white-space: nowrap; font-weight: 600; font-size: 0.9375rem; }
  .main-nav a, .menu nav a { color: var(--color-text); text-decoration: none; padding: var(--space-2) 0; border-bottom: 2px solid transparent; }
  .main-nav a[aria-current="page"] { border-bottom-color: var(--color-gold); }
  .menu { margin-left: auto; position: relative; }
  .menu summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; padding: 0 var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-pill); font-weight: 600; list-style: none; }
  .menu nav { position: absolute; right: 0; top: calc(100% + var(--space-2)); width: min(18rem, 85vw); background: var(--color-raised); border: 1px solid var(--color-line); border-radius: var(--radius); box-shadow: var(--shadow-menu); padding: var(--space-3) var(--space-4); display: flex; flex-direction: column; font-family: var(--font-title); font-size: 1.375rem; }
  .cta { display: none; }
  .verse-bar .date { display: none; }
  .verse-bar .verse { font-size: var(--text-base); }
  @media (min-width: 64rem) {
    .site-header { padding-block: var(--space-4); }
    .brand { font-size: 1.375rem; }
    .brand img { width: 48px; height: 48px; }
    .main-nav { display: flex; }
    .menu { display: none; }
    .cta { display: inline-block; background: var(--color-primary); color: var(--color-on-primary); border-radius: var(--radius-pill); padding: var(--space-3) var(--space-5); font-weight: 600; text-decoration: none; white-space: nowrap; }
    .verse-bar .date { display: inline; }
    .verse-bar .verse { font-size: var(--text-lg); }
  }
</style>
