---
import ResponsiveImage from "./ResponsiveImage.astro";
interface Props { title: string; coverUrl: string | null; tone?: number }
const { title, coverUrl, tone = 0 } = Astro.props;
---
<span class={`cover t${tone}`}>{coverUrl ? <ResponsiveImage src={coverUrl} widths={[160, 240, 320, 480]} sizes="(min-width: 40rem) 12rem, 40vw" /> : <span class="ph">{title}</span>}</span>
<style>
  .cover { display: block; aspect-ratio: 2 / 3; border-radius: 8px; background: var(--d-cover-1); border: 1px solid var(--color-line); overflow: hidden; }
  .t1 { background: var(--d-cover-2); }
  .t2 { background: var(--d-cover-3); }
  .cover img { display: block; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .ph { display: flex; align-items: center; justify-content: center; block-size: 100%; padding: var(--space-3); text-align: center; font: 600 1.125rem / 1.2 var(--font-title); }
</style>
