---
import { richTextToPlain } from "../lib/data/client";
import { richTextToHtml } from "../lib/rich-text";
import { dayParts, formatLagosShortDate } from "@kcom/content";
import type { CapsulePageData } from "../lib/capsule-page";
import DateNav from "./DateNav.astro";
import LinkCard from "./LinkCard.astro";
import ShareLinks from "./ShareLinks.astro";

interface Props {
  page: CapsulePageData;
  /** "today" adds date arrows and the email band; "past" adds breadcrumb and related lists. */
  mode: "today" | "past";
  /** The Lagos calendar day right now, YYYY-MM-DD. */
  today: string;
  shareUrl: string;
}
const { page, mode, today, shareUrl } = Astro.props;
const { capsule, prev, next, seriesInfo, past } = page;
const day = dayParts(capsule.displayDate);
const scripture = richTextToPlain(capsule.scriptureText);
const meditation = scripture || capsule.bibleMeditation;
const hasMeditation = Boolean(meditation);
const href = (c: { slug: string }) => `/capsules/${c.slug}`;
const series = capsule.series;
const part = capsule.partNumber;
const total = seriesInfo?.series.count ?? 0;
const seriesLabel = series ? `${series.title}${part ? ` · Day ${part}${total > 1 && part <= total ? ` of ${total}` : ""}` : ""}` : "";
const upcoming = mode === "today" && !next && capsule.displayDate === today;
const showRelated = mode === "past" && (Boolean(seriesInfo) || past.length > 0);
const bodyHtml = richTextToHtml(capsule.body);
const prayerHtml = capsule.prayer ? richTextToHtml(capsule.prayer) : "";
---
{capsule.bannerUrl && <div class="banner"><img src={capsule.bannerUrl} alt="" /></div>}
<article class:list={["capsule", mode]}>
  {mode === "today" ? (
    <DateNav day={day} prevHref={prev ? href(prev) : undefined} nextHref={next ? href(next) : undefined} />
  ) : (
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/capsules">Capstone Capsules</a>
      {series && <> › <a href={`/series/${series.slug}`}>{series.title}</a>{part && ` › Day ${part}`}</>}
    </nav>
  )}

  <header class="head">
    {mode === "past" && <span class="date"><span class="wd-long">{day.weekday}</span><span class="wd-short">{day.weekday.slice(0, 3)}</span> · {day.rest}</span>}
    {mode === "today" && series && <a class="pill" href={`/series/${series.slug}`}><span class="pre">Series · </span>{seriesLabel}</a>}
    <h1>{capsule.title}</h1>
  </header>

  {hasMeditation && (
    <section class="meditation" aria-label="Bible meditation">
      <span class="eyebrow">BIBLE MEDITATION</span>
      <span class="rule" aria-hidden="true"></span>
      <p class="verse">{meditation}</p>
      {(capsule.scriptureRef || (scripture && capsule.bibleMeditation)) && (
        <span class="ref">{capsule.scriptureRef}{scripture && capsule.bibleMeditation && <>{capsule.scriptureRef ? " · " : ""}Read {capsule.bibleMeditation}</>}</span>
      )}
    </section>
  )}

  <div class:list={["prose", { dropcap: mode === "today" }]} set:html={bodyHtml} />

  {capsule.decrees.length > 0 && (
    <section class="decrees" aria-label="Decrees">
      <h2>Decrees</h2>
      <ul>{capsule.decrees.map((d) => <li><span aria-hidden="true">✦</span><span>{d}</span></li>)}</ul>
    </section>
  )}

  {prayerHtml && (
    <section class="prayer" aria-label="Prayer">
      <h2>Prayer</h2>
      <div class="prose" set:html={prayerHtml} />
    </section>
  )}

  {capsule.authorSource && <p class="author">{capsule.authorSource}</p>}

  <ShareLinks url={shareUrl} title={capsule.title} />

  <nav class="more" aria-label={mode === "today" ? "More capsules" : "Previous and next"}>
    {prev ? <LinkCard href={href(prev)} label={`← ${mode === "today" ? "Previous · " : ""}${formatLagosShortDate(prev.displayDate)}`} title={prev.title} /> : <span class="gap"></span>}
    {next
      ? <LinkCard end href={href(next)} label={`${mode === "today" ? "Next · " : ""}${formatLagosShortDate(next.displayDate)} →`} title={next.title} />
      : upcoming ? <LinkCard end label="Next · tomorrow" title="Arrives at midnight (Lagos time)" /> : <span class="gap"></span>}
  </nav>
</article>

{showRelated && (
  <section class="related" aria-label="Related">
    <div class="related-inner">
      {seriesInfo && (
        <div class="col">
          <h2>In this series · {seriesInfo.series.title}</h2>
          {seriesInfo.members.map((m) => (
            <a class:list={["row", { current: m.slug === capsule.slug }]} href={href(m)} aria-current={m.slug === capsule.slug ? "page" : undefined}>
              <span class="when">{m.partNumber ? `Day ${m.partNumber}` : formatLagosShortDate(m.displayDate)}</span>
              <span class="name">{m.title}</span>
            </a>
          ))}
          {seriesInfo.truncated && <a class="all" href={`/series/${seriesInfo.series.slug}`}>See all {seriesInfo.series.count} days →</a>}
        </div>
      )}
      {past.length > 0 && (
        <div class="col">
          <h2>On this day in past years</h2>
          {past.map((p) => (
            <a class="row" href={href(p)}>
              <span class="when">{p.displayDate.slice(0, 4)}</span>
              <span class="stack"><span class="name">{p.title}</span>{p.scriptureRef && <span class="sub">{p.scriptureRef}</span>}</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
)}

{mode === "today" && (
  <section class="signup" aria-label="Email signup">
    <form action="/subscribe" method="post">
      <div class="signup-text"><h2>Receive tomorrow’s capsule</h2><p>Every day at midnight, Lagos time. Free.</p></div>
      <label class="sr-only" for="capsule-email">Email address</label>
      <input id="capsule-email" class="kc-input" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
      <button type="submit" class="kc-btn kc-btn--primary">Subscribe</button>
    </form>
  </section>
)}

<style>
  .banner { block-size: 220px; background: var(--color-wash); overflow: hidden; }
  .banner img { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; }
  .capsule { max-inline-size: calc(45rem + 2 * var(--space-5)); margin-inline: auto; padding: var(--space-5) var(--space-5) var(--space-7); font-size: var(--text-reading); line-height: var(--leading-reading); display: flex; flex-direction: column; gap: 1.4rem; }
  h1 { margin: 0; font-family: var(--font-title); font-weight: 500; font-size: clamp(2.5rem, 8vw, 3.5rem); line-height: 1.05; }
  h2 { margin: 0; font-family: var(--font-title); font-weight: 600; font-size: 1.75rem; }
  .crumbs { font-size: var(--text-sm); line-height: 1.4; color: var(--color-muted); }
  .head { display: flex; flex-direction: column; gap: var(--space-3); }
  .today .head { align-items: center; text-align: center; gap: var(--space-2); }
  .date { font-size: var(--text-xs); letter-spacing: 0.1em; font-variant: small-caps; font-weight: 700; color: var(--color-gold-text); }
  .wd-short { display: inline; } .wd-long { display: none; }
  .pill { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.04em; color: var(--color-muted); background: var(--color-wash); border-radius: var(--radius-pill); padding: 3px 12px; text-decoration: none; }
  .pre { display: none; }
  .meditation { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); }
  .today .meditation { text-align: center; align-items: center; }
  .eyebrow { font-size: var(--text-xs); letter-spacing: 0.14em; font-weight: 700; color: var(--color-muted); }
  .rule { inline-size: 2.25rem; block-size: 2px; background: var(--color-gold); }
  .past .rule { display: none; }
  .verse { margin: 0; font-family: var(--font-scripture); font-style: italic; font-size: 1.15rem; line-height: 1.6; }
  .ref { font-size: 0.8125rem; letter-spacing: 0.1em; font-variant: small-caps; font-weight: 700; color: var(--color-gold-text); }
  .prose { display: flex; flex-direction: column; gap: 1.25rem; }
  .prose :global(p) { margin: 0; }
  .prose :global(blockquote) { margin: var(--space-2) 0; font-family: var(--font-title); font-style: italic; font-size: 1.75rem; line-height: 1.3; text-align: center; color: var(--color-primary); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { margin: 0; font-family: var(--font-title); }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-inline-start: 1.4rem; }
  .prose :global(a) { color: var(--color-primary); }
  .capsule > .prose.dropcap > :global(p:first-child)::first-letter { font-family: var(--font-title); font-size: 4rem; line-height: 0.8; float: left; padding: 6px 10px 0 0; color: var(--color-primary); }
  .decrees { background: var(--color-sandstone); border-radius: var(--radius); padding: 1.75rem var(--space-6); display: flex; flex-direction: column; gap: 10px; }
  .decrees ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .decrees li { display: flex; gap: var(--space-3); }
  .decrees li > span:first-child { color: var(--color-gold-text-tint); font-weight: 700; }
  .prayer { border-block-start: 1px solid var(--color-line); padding-block-start: var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); }
  .prayer .prose { font-style: italic; }
  .author { margin: 0; font-size: var(--text-sm); color: var(--color-muted); }
  .more { display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
  .gap { display: none; }
  .related { background: var(--color-wash); padding: var(--space-7) var(--gutter); }
  .related-inner { margin-inline: auto; display: flex; flex-wrap: wrap; gap: var(--space-7); line-height: 1.4; }
  .col { flex: 1 1 22rem; min-inline-size: 0; display: flex; flex-direction: column; gap: 6px; }
  .col h2 { margin-block-end: var(--space-2); font-size: 2rem; }
  .row { display: flex; gap: var(--space-4); padding: 10px 0; border-block-start: 1px solid var(--color-line); color: var(--color-text); text-decoration: none; }
  .all { margin-block-start: var(--space-2); font-weight: 600; color: var(--color-primary); }
  .row.current { background: var(--color-surface); border-radius: 10px; padding: 10px 12px; border-block-start-color: transparent; }
  .row:hover .name { text-decoration: underline; }
  .when { inline-size: 3.5rem; flex: none; font-size: 0.8125rem; font-weight: 700; color: var(--color-muted); }
  .name { font-family: var(--font-title); font-weight: 600; font-size: 1.3125rem; }
  .stack { display: flex; flex-direction: column; }
  .sub { font-size: var(--text-sm); color: var(--color-muted); }
  .signup { background: var(--color-wash); padding: var(--space-7) var(--gutter); }
  .signup form { max-inline-size: 45rem; margin-inline: auto; display: flex; flex-wrap: wrap; gap: var(--space-4); align-items: center; line-height: 1.4; }
  .signup-text { flex: 1 1 17rem; }
  .signup-text p { margin: var(--space-1) 0 0; font-size: var(--text-sm); color: var(--color-muted); }
  .signup :global(.kc-input) { flex: 1 1 14rem; min-inline-size: 0; }
  @media (min-width: 48rem) {
    .capsule { padding-block: 2.5rem 3.5rem; gap: 1.75rem; }
    .wd-short { display: none; } .wd-long { display: inline; }
    .date { font-size: var(--text-sm); }
    .pill { font-size: 0.8125rem; } .pre { display: inline; }
    .meditation { padding: 1.75rem var(--space-6); }
    .verse { font-size: 1.3125rem; }
    .more { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gap { display: block; }
    .row .name { font-size: 1.3125rem; }
  }
</style>
