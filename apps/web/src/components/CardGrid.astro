---
/** Responsive grid for cards: one column on phones, two on tablets, three on desktop. */
---
<div class="grid"><slot /></div>
<style>
  .grid { display: grid; gap: var(--space-5); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 40rem) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
