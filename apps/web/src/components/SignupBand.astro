---
import SignupForm from "./SignupForm.astro";
interface Props {
  title?: string;
  text?: string;
  id?: string;
}
const { title = "Get Capstone Capsules by email", text = "A short word from Scripture, every day at midnight (Lagos time).", id = "band-email" } = Astro.props;
---
<section class="band" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <p>{text}</p>
  <SignupForm {id} buttonClass="kc-btn--md" />
</section>
<style>
  .band { background: var(--color-footer); color: var(--color-on-footer); border-radius: var(--radius); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); }
  h2 { margin: 0; font-family: var(--font-title); font-weight: 500; font-size: 1.5rem; }
  p { margin: 0; opacity: 0.9; }
  .band :global(.kc-btn) { background: var(--color-footer-button); color: var(--color-on-footer-button); }
  @media (min-width: 48rem) { .band { padding: var(--space-6); } h2 { font-size: 1.875rem; } }
</style>
