---
interface Props {
  href: string;
  /** Small caps line above the big figure (e.g. SAT or DAY). */
  kicker: string;
  /** The big figure (day of month or part number). */
  figure: string | number;
  title: string;
  meta?: string | null;
  /** Pill on the right; hidden on phones. */
  badge?: string | null;
}
const { href, kicker, figure, title, meta, badge } = Astro.props;
---
<a class="row" href={href}>
  <span class="fig"><span class="kicker">{kicker}</span><span class="n">{figure}</span></span>
  <span class="text"><span class="title">{title}</span>{meta && <span class="meta">{meta}</span>}</span>
  {badge && <span class="badge">{badge}</span>}
</a>
<style>
  .row { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-3) 0; border-top: 1px solid var(--color-line); color: var(--color-text); text-decoration: none; }
  .row:hover .title { color: var(--color-primary); }
  .fig { inline-size: 2.5rem; flex: none; display: flex; flex-direction: column; align-items: center; line-height: 1.1; }
  .kicker { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-muted); }
  .n { font: 600 1.625rem / 1.1 var(--font-title); }
  .text { display: flex; flex-direction: column; min-inline-size: 0; line-height: 1.3; }
  .title { font: 600 1.3125rem / 1.2 var(--font-title); overflow-wrap: anywhere; }
  .meta { font-size: var(--text-sm); color: var(--color-muted); }
  .badge { display: none; margin-inline-start: auto; flex: none; font-size: 0.8125rem; font-weight: 700; color: var(--color-primary); background: var(--color-hover); border-radius: var(--radius-pill); padding: var(--space-1) var(--space-3); }
  @media (min-width: 48rem) {
    .row { gap: var(--space-5); padding: var(--space-4) 0; }
    .fig { inline-size: 3.5rem; }
    .kicker { font-size: var(--text-xs); }
    .n { font-size: 1.875rem; }
    .title { font-size: 1.5rem; }
    .badge { display: inline-block; }
  }
</style>
