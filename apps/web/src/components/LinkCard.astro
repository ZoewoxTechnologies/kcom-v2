---
interface Props {
  label: string;
  title?: string;
  href?: string;
  /** Right-aligned text, for "next" cards. */
  end?: boolean;
  /** Adds a ← (prev) or → (next) arrow that nudges on hover. */
  dir?: "prev" | "next";
  /** Larger type and padding, for page-level navigation. */
  large?: boolean;
}
const { label, title, href, end = false, dir, large = false } = Astro.props;
const Tag = href ? "a" : "div";
---
<Tag class:list={["link-card", { large, end, empty: !href, [dir ?? ""]: !!dir }]} href={href}>
  <span class="text">
    <span class="label">{label}</span>
    {title && <span class="title">{title}</span>}
  </span>
  {dir && href && <span class="arrow" aria-hidden="true">{dir === "prev" ? "←" : "→"}</span>}
</Tag>
<style>
  .link-card { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) var(--space-5); border: 1px solid var(--color-line); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); text-decoration: none; line-height: 1.4; }
  .large { padding: 18px 22px; }
  .large .label { font-size: 0.8125rem; }
  .large .title { font-size: 1.5rem; }
  .large .arrow { font-size: 1.375rem; }
  .text { display: flex; flex-direction: column; gap: var(--space-1); min-inline-size: 0; }
  a.link-card { cursor: pointer; transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
  a.link-card:hover { border-color: var(--color-primary); transform: translateY(-2px); box-shadow: 0 6px 16px var(--color-ring); }
  a.link-card:focus-visible { outline: none; border-color: var(--color-primary); box-shadow: var(--focus-ring); }
  .link-card.empty { background: transparent; border-style: dashed; }
  .end { text-align: end; justify-content: flex-end; }
  .next { flex-direction: row; }
  .prev { flex-direction: row-reverse; justify-content: flex-end; }
  .end .text { align-items: flex-end; }
  .label { font-size: var(--text-sm); color: var(--color-muted); }
  .title { font-family: var(--font-title); font-weight: 600; font-size: 1.3rem; }
  .empty .title { color: var(--color-muted); }
  .arrow { font-size: 1.5rem; color: var(--color-primary); transition: transform 0.15s; }
  a.link-card:hover .next .arrow, a.next:hover .arrow { transform: translateX(4px); }
  a.prev:hover .arrow { transform: translateX(-4px); }
  @media (prefers-reduced-motion: reduce) { a.link-card, .arrow { transition: none; } a.link-card:hover { transform: none; } a.next:hover .arrow, a.prev:hover .arrow { transform: none; } }
</style>
