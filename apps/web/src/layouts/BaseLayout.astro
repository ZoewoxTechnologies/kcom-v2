---
import "@kcom/ui/styles.css";
import "@kcom/ui/button.css";
import "@kcom/ui/forms.css";
import "@kcom/ui/menu.css";
import { fontsHref } from "@kcom/ui/fonts";
import Analytics from "../components/Analytics.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { pageTitle } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Let the page run edge to edge (banners, tinted bands). */
  bleed?: boolean;
}
const { title, description, current = Astro.url.pathname, bleed = false } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title)}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main" class:list={{ bleed }}><slot /></main>
    <SiteFooter />
  </body>
</html>
<style is:global>
  .skip-link { position: absolute; left: var(--space-4); top: -4rem; z-index: 20; background: var(--color-primary); color: var(--color-on-primary); padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill); }
  .skip-link:focus { top: var(--space-2); }
  main h1 { font-size: clamp(2.25rem, 8vw, var(--text-3xl)); overflow-wrap: anywhere; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  main.bleed { max-width: none; padding: 0; }
  body { min-height: 100vh; display: flex; flex-direction: column; }
  main { flex: 1; width: 100%; box-sizing: border-box; max-width: var(--page-max); margin-inline: auto; padding: var(--space-6) var(--gutter); }
</style>
