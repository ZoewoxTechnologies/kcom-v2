PUBLIC_API_URL=http://localhost:3000

# Public site data: "sample" serves built-in sample data; "api" (default) reads PUBLIC_API_URL; sample data is a fallback outside production builds only.
DATA_SOURCE=api

# Sentry (optional; no-op when DSNs are empty). PUBLIC_* values are build-time.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=
PUBLIC_SENTRY_RELEASE=
# Source map upload at build time (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog (optional; build-time; no-op when key is empty; honours Do Not Track)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile site key for the email signup form (optional; build-time; the widget is omitted when empty).
# The matching secret key belongs to the API, not the web app.
PUBLIC_TURNSTILE_SITE_KEY=
