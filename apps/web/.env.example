# Base URL of the API the site reads content from.
PUBLIC_API_URL=http://localhost:3000

# Public site data: "sample" serves built-in sample data; "api" (default) reads PUBLIC_API_URL; sample data is a fallback outside production builds only.
DATA_SOURCE=api

# Sentry (optional; no-op when DSNs are empty). PUBLIC_* values are build-time.
SENTRY_DSN=
# Environment name reported to Sentry, e.g. production.
SENTRY_ENVIRONMENT=
# Release identifier reported to Sentry.
SENTRY_RELEASE=
# Sentry DSN for browser errors; empty disables reporting.
PUBLIC_SENTRY_DSN=
# Environment name reported to Sentry from the browser.
PUBLIC_SENTRY_ENVIRONMENT=
# Release identifier reported to Sentry from the browser.
PUBLIC_SENTRY_RELEASE=
# Source map upload at build time (optional)
SENTRY_AUTH_TOKEN=
# Sentry organisation slug, for source map upload at build.
SENTRY_ORG=
# Sentry project slug, for source map upload at build.
SENTRY_PROJECT=

# PostHog (optional; build-time; no-op when key is empty; honours Do Not Track)
PUBLIC_POSTHOG_KEY=
# PostHog ingestion host.
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public origin of the site, e.g. https://kingdomcapstone.org. Required in production.
PUBLIC_SITE_URL=

# Build-time only. "true" lets a throwaway CI build make the search index without PUBLIC_API_URL; never set it for a real build.
# SEARCH_INDEX_PARTIAL_OK=
