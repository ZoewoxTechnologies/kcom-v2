# Port the API listens on.
PORT=3000
# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/kcom
# Comma-separated origins allowed to call the API (web site and admin).
CORS_ORIGINS=http://localhost:4321,http://localhost:5173

# Sentry (optional; error reporting is a no-op when SENTRY_DSN is empty)
SENTRY_DSN=
# Environment name reported to Sentry, e.g. production.
SENTRY_ENVIRONMENT=
# Release identifier reported to Sentry.
SENTRY_RELEASE=
# Fraction of requests traced, 0 to 1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Auth. Secret: `openssl rand -base64 32`. URL is this API's public URL.
BETTER_AUTH_SECRET=
# Public URL of this API, used by auth for callbacks and trusted origins.
BETTER_AUTH_URL=http://localhost:3000
# Set to the shared parent domain (e.g. .example.org) when admin and API are
# subdomains of it. Leave empty when they are on unrelated sites.
COOKIE_DOMAIN=
# Local http development only: set to false so cookies work without TLS.
COOKIE_SECURE=true
# Used only by `pnpm --filter @kcom/api seed:users`. Passwords are optional:
# when unset, a new user gets a generated one, printed once.
ADMIN_EMAIL=
# Password for the seeded admin user; generated and printed once when unset.
ADMIN_PASSWORD=
# Email of the seeded editor user.
EDITOR_EMAIL=editor@example.com
# Password for the seeded editor user; generated and printed once when unset.
EDITOR_PASSWORD=

# Cloudinary image uploads (admin signs uploads here; the browser uploads directly).
# Placeholders only: real values live in the deploy environment, never in git.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key used to sign uploads.
CLOUDINARY_API_KEY=
# Cloudinary API secret used to sign uploads. Never commit a real value.
CLOUDINARY_API_SECRET=
# Optional. Uploads are signed either way; set a signed upload preset (Cloudinary dashboard)
# to also enforce folder, allowed formats png/jpg/webp and max file size on Cloudinary's side.
CLOUDINARY_UPLOAD_PRESET=

# Bearer token for POST /internal/publish-due, called by the scheduled job that
# publishes capsules at midnight. Unset disables /internal (404).
# Generate with: openssl rand -base64 32
INTERNAL_JOB_TOKEN=

# Reverse-proxy hops in front of the API (Cloud Run, Railway: 1). The contact rate limit reads the client IP
# this many entries from the right of X-Forwarded-For. Positive integer; invalid values fall back to 1.
TRUSTED_PROXY_HOPS=1

# Site rebuild on publish. Webhook that starts the site build or deploy; unset turns rebuilds off.
REBUILD_HOOK_URL=
# Sent as a Bearer token with the rebuild request, when the webhook needs one.
REBUILD_HOOK_TOKEN=
# JSON body of the rebuild request. Default {"source":"kcom-api"}.
REBUILD_HOOK_BODY=
# Quiet time in ms after the last change before one rebuild request is sent. Default 60000.
REBUILD_DEBOUNCE_MS=
