{
  "name": "@kcom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc",
    "seed:users": "tsx src/seed-users.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@kcom/content": "workspace:*",
    "@kcom/db": "workspace:*",
    "@kcom/media": "workspace:*",
    "@kcom/permissions": "workspace:*",
    "@sentry/node": "^11.14.0",
    "better-auth": "^1.7.26",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@kcom/config": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "exports": {
    "./app": "./src/app.ts"
  }
}
