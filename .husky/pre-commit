pnpm exec lint-staged --concurrent false
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is required but not installed. Install it (brew install gitleaks) and retry." >&2
  echo "Bypass explicitly with HUSKY=0 or --no-verify." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner
