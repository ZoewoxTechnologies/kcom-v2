{
  "name": "kcom-v2",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:ports": "node scripts/dev-ports.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@kcom/config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.3"
  },
  "prettier": "@kcom/config/prettier"
}
