# PostgreSQL connection string (Neon dev branch or local Postgres).
# Example local: postgres://localhost:5432/kcom_dev
DATABASE_URL=

# Public site data: "sample" serves built-in sample data; "api" (default) reads PUBLIC_API_URL; sample data is a fallback outside production builds only.
DATA_SOURCE=api

# Public origin of the site, e.g. https://kingdomcapstone.org. Required in production.
PUBLIC_SITE_URL=

# One-off Drupal migration tool (packages/migrate). Path to the Drupal MySQL dump; required to run extract.
# LEGACY_SQL=
# Optional: where extracted and transformed data go (default data/legacy/extract).
# EXTRACT_DIR=
# Optional: directory of legacy files and where transformed output goes (defaults data/legacy/files, data/legacy/transform).
# LEGACY_FILES=
# TRANSFORM_DIR=
