# Root tooling only. Each app has its own .env.example: copy it to .env.local in that app's folder.
# These are read from the shell environment, e.g. `set -a; source .env; set +a`.

# Database migrations and seed (packages/db): PostgreSQL connection string.
# Example local: postgres://localhost:5432/kcom_dev
DATABASE_URL=

# Legacy Drupal import (packages/migrate). Paths default to data/legacy/*.
LEGACY_SQL=
EXTRACT_DIR=data/legacy/extract
LEGACY_FILES=data/legacy/files
TRANSFORM_DIR=data/legacy/transform
