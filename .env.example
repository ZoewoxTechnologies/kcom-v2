# Root tooling only. Each app has its own .env.example: copy it to .env.local in that app's folder.
# These are read from the shell environment, e.g. `set -a; source .env; set +a`.

# PostgreSQL connection string (Neon dev branch or local Postgres). Used by migrations and seed (packages/db).
# Example local: postgres://localhost:5432/kcom_dev
DATABASE_URL=

# One-off Drupal migration tool (packages/migrate). Path to the Drupal MySQL dump; required to run extract.
# LEGACY_SQL=
# Optional: where extracted and transformed data go (default data/legacy/extract).
# EXTRACT_DIR=
# Optional: directory of legacy files and where transformed output goes (defaults data/legacy/files, data/legacy/transform).
# LEGACY_FILES=
# TRANSFORM_DIR=

# Tests only. `pnpm dev:ports` treats this port as the main checkout's API (default 3000) when deciding
# whether a worktree can share it. Leave unset.
# KCOM_SHARED_API_PORT=3000

# Object storage for the nightly backup and the monthly activity-log archive (packages/db, `pnpm --filter @kcom/db db:archive-activity`).
# The archive job and manual runs need all of these; in GitHub Actions they come from the BACKUP_S3_* repository secrets and variables.
# S3-compatible endpoint URL, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Bucket that holds the backups; archives go under activity/ in it.
S3_BUCKET=
# Access key id for that bucket (needs read, write and head on it). Never commit a real value.
AWS_ACCESS_KEY_ID=
# Secret for the access key above. Never commit a real value.
AWS_SECRET_ACCESS_KEY=
# Bucket region; "auto" for Cloudflare R2.
AWS_DEFAULT_REGION=auto
# Optional. Server-side encryption requested on archive uploads (default AES256). Set to "none" only for a bucket that rejects it.
# S3_SERVER_SIDE_ENCRYPTION=AES256
